<section
  id="ColeccionesSaucha-{{ section.id }}"
  class="
    s-section s-scheme-{{ section.settings.scheme }}
    s-pt-{{ section.settings.spacing_top }} s-pb-{{ section.settings.spacing_bottom }}
    colecciones-saucha colecciones-saucha--{{ section.settings.size }}
  "
>
  <div class="s-container">
    {% render 'saucha-heading',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      alignment: section.settings.heading_alignment,
      size: 'h2'
    %}

    <div class="colecciones-saucha__scroll" data-colecciones-scroll>
      <ul class="colecciones-saucha__lista" role="list">
        {%- assign visible_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign coleccion = block.settings.coleccion
            assign imagen = blank
            assign titulo = blank
            assign enlace = blank

            if coleccion != blank
              assign imagen = coleccion.featured_image
              assign titulo = coleccion.title
              assign enlace = coleccion.url
            endif

            if block.settings.imagen_personalizada != blank
              assign imagen = block.settings.imagen_personalizada
            endif

            if block.settings.titulo_personalizado != blank
              assign titulo = block.settings.titulo_personalizado
            endif

            if block.settings.enlace_personalizado != blank
              assign enlace = block.settings.enlace_personalizado
            endif

            # Respaldo: un nombre sin colección asignada enlaza a /collections/<nombre> si existe
            if enlace == blank and titulo != blank
              assign handle_guess = titulo | handleize
              assign coleccion_guess = collections[handle_guess]
              if coleccion_guess != blank and coleccion_guess.id != blank
                assign enlace = coleccion_guess.url
                if imagen == blank
                  assign imagen = coleccion_guess.featured_image
                endif
              endif
            endif

            assign is_empty = false
            if coleccion == blank and block.settings.imagen_personalizada == blank and block.settings.titulo_personalizado == blank
              assign is_empty = true
            endif
          -%}

          {%- if is_empty and request.design_mode == false -%}
            {%- continue -%}
          {%- endif -%}

          <li
            class="colecciones-saucha__elemento"
            data-s-reveal="up"
            style="--s-i: {{ visible_index }};"
            {{ block.shopify_attributes }}
          >
            <a
              class="colecciones-saucha__item{% if block.settings.destacada %} colecciones-saucha__item--destacada{% endif %}"
              {% if enlace != blank %}href="{{ enlace }}"{% else %}aria-disabled="true"{% endif %}
            >
              <span class="colecciones-saucha__circulo">
                <span class="colecciones-saucha__imagen">
                  {%- if imagen != blank -%}
                    {{
                      imagen
                      | image_url: width: 480
                      | image_tag:
                        loading: 'lazy',
                        widths: '160, 240, 320, 400, 480',
                        sizes: '(min-width: 750px) 176px, 120px',
                        alt: ''
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </span>

                {%- if block.settings.destacada and block.settings.texto_destacado != blank -%}
                  <span class="colecciones-saucha__badge">{{ block.settings.texto_destacado | escape }}</span>
                {%- endif -%}
              </span>

              <span class="colecciones-saucha__nombre">
                {{- titulo | default: 'Colección' | escape -}}
              </span>
            </a>
          </li>
          {%- assign visible_index = visible_index | plus: 1 -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Colecciones Saucha: accesos circulares. Carril táctil en móvil, fila centrada (o arrastrable) en escritorio. */

  .colecciones-saucha {
    --cs-size: 92px;
    --cs-gap: var(--s-space-4);
  }

  .colecciones-saucha--small { --cs-size: 80px; }
  .colecciones-saucha--large { --cs-size: 108px; }

  .colecciones-saucha .s-heading {
    margin-bottom: var(--s-space-8);
  }

  .colecciones-saucha__scroll {
    margin-inline: calc(var(--s-gutter) * -1);
    padding-inline: var(--s-gutter);
    scroll-padding-inline: var(--s-gutter);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .colecciones-saucha__scroll::-webkit-scrollbar {
    display: none;
  }

  .colecciones-saucha__scroll.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .colecciones-saucha__lista {
    display: flex;
    gap: var(--cs-gap);
    width: max-content;
    min-width: 100%;
    margin: 0;
    padding: 6px 0;
    list-style: none;
    justify-content: flex-start;
  }

  .colecciones-saucha__elemento {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .colecciones-saucha__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-space-3);
    width: var(--cs-size);
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .colecciones-saucha__circulo {
    position: relative;
    display: block;
    width: var(--cs-size);
    aspect-ratio: 1;
  }

  /* Anillo fino que aparece en hover/foco */
  .colecciones-saucha__circulo::after {
    content: '';
    position: absolute;
    inset: -5px;
    border: 1px solid var(--s-fg);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity var(--s-dur-micro) var(--s-ease),
      transform var(--s-dur-image) var(--s-ease);
  }

  .colecciones-saucha__imagen {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: 50%;
    background: var(--s-color-blush);
  }

  .colecciones-saucha__imagen img,
  .colecciones-saucha__imagen svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform calc(var(--s-dur-image) * 2) var(--s-ease);
  }

  .colecciones-saucha__imagen svg {
    fill: rgb(var(--s-color-ink-rgb) / 0.14);
    background: var(--s-color-cream);
  }

  .colecciones-saucha__badge {
    position: absolute;
    left: 50%;
    bottom: -4px;
    z-index: 1;
    padding: 4px 9px;
    border-radius: var(--s-radius-pill);
    background: var(--s-color-salmon);
    color: var(--s-color-ink);
    font-family: var(--s-font-sans);
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .colecciones-saucha__nombre {
    max-width: 100%;
    font-family: var(--s-font-serif);
    font-size: 1.0625rem;
    line-height: 1.2;
    text-align: center;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) {
    .colecciones-saucha__item:hover .colecciones-saucha__circulo::after {
      opacity: 1;
      transform: none;
    }

    .colecciones-saucha__item:hover .colecciones-saucha__imagen img {
      transform: scale(1.05);
    }
  }

  .colecciones-saucha__item:focus-visible {
    outline: none;
  }

  .colecciones-saucha__item:focus-visible .colecciones-saucha__circulo::after {
    opacity: 1;
    transform: none;
    border-width: 2px;
  }

  @media screen and (min-width: 750px) {
    .colecciones-saucha { --cs-size: 136px; --cs-gap: var(--s-space-8); }
    .colecciones-saucha--small { --cs-size: 112px; }
    .colecciones-saucha--large { --cs-size: 168px; }

    .colecciones-saucha .s-heading {
      margin-bottom: var(--s-space-12);
    }

    .colecciones-saucha__lista {
      justify-content: center;
    }

    .colecciones-saucha__nombre {
      font-size: 1.1875rem;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const init = (section) => {
      const scroller = section?.querySelector('[data-colecciones-scroll]');
      if (!scroller || scroller.dataset.dragReady) return;
      scroller.dataset.dragReady = 'true';

      let startX = 0;
      let startScroll = 0;
      let dragging = false;
      let moved = false;

      scroller.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        if (scroller.scrollWidth <= scroller.clientWidth) return;
        dragging = true;
        moved = false;
        startX = event.clientX;
        startScroll = scroller.scrollLeft;
      });

      scroller.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const delta = event.clientX - startX;
        if (!moved && Math.abs(delta) > 5) {
          moved = true;
          scroller.classList.add('is-dragging');
          scroller.setPointerCapture?.(event.pointerId);
        }
        if (moved) scroller.scrollLeft = startScroll - delta;
      });

      const stop = () => {
        dragging = false;
        scroller.classList.remove('is-dragging');
      };

      scroller.addEventListener('pointerup', stop);
      scroller.addEventListener('pointercancel', stop);

      /* No abrir la colección al soltar después de arrastrar */
      scroller.addEventListener(
        'click',
        (event) => {
          if (!moved) return;
          event.preventDefault();
          moved = false;
        },
        true
      );
    };

    init(document.getElementById('ColeccionesSaucha-{{ section.id }}'));

    document.addEventListener('shopify:section:load', (event) => {
      init(event.target.querySelector('.colecciones-saucha'));
    });
  })();
</script>

{% schema %}
{
  "name": "Colecciones Saucha",
  "tag": "div",
  "class": "colecciones-saucha-section",
  "max_blocks": 14,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Título",
      "default": "Descubre nuestras colecciones"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alineación del título",
      "options": [
        { "value": "center", "label": "Centrado" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Tamaño de los círculos",
      "options": [
        { "value": "small", "label": "Pequeño" },
        { "value": "medium", "label": "Medio" },
        { "value": "large", "label": "Grande" }
      ],
      "default": "medium",
      "info": "En móvil los círculos se deslizan con el dedo; en escritorio se centran y, si no caben, se pueden arrastrar."
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Marfil (principal)" },
        { "value": "cream", "label": "Crema (alterno)" },
        { "value": "blush", "label": "Blush nude" }
      ],
      "default": "surface"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Espacio superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "coleccion",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "coleccion",
          "label": "Colección",
          "info": "El nombre, la imagen y el enlace se cargan automáticamente. Los círculos vacíos no se muestran en la tienda."
        },
        {
          "type": "header",
          "content": "Opcional"
        },
        {
          "type": "image_picker",
          "id": "imagen_personalizada",
          "label": "Imagen personalizada",
          "info": "Recomendado cuadrada, 480 × 480 px. Si no eliges ninguna se usa la de la colección."
        },
        {
          "type": "text",
          "id": "titulo_personalizado",
          "label": "Nombre personalizado"
        },
        {
          "type": "url",
          "id": "enlace_personalizado",
          "label": "Enlace personalizado"
        },
        {
          "type": "checkbox",
          "id": "destacada",
          "label": "Mostrar etiqueta",
          "default": false
        },
        {
          "type": "text",
          "id": "texto_destacado",
          "label": "Texto de la etiqueta",
          "default": "Rebajas",
          "visible_if": "{{ block.settings.destacada }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones Saucha",
      "category": "t:categories.collections",
      "blocks": [
        { "type": "coleccion" },
        { "type": "coleccion" },
        { "type": "coleccion" },
        { "type": "coleccion" },
        { "type": "coleccion" },
        { "type": "coleccion" }
      ]
    }
  ]
}
{% endschema %}
