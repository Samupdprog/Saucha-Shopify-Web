{{ 'saucha-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'saucha-collection.js' | asset_url }}" defer></script>

{% liquid
  # Origen de los productos:
  #   collection ........ la colección elegida
  #   product_collection  (ficha) la categoría del producto: colección desde la que se llegó o su primera colección
  #   related ........... (ficha) relacionados de Shopify
  #   complementary ..... (ficha) complementarios (Search & Discovery)
  assign source = section.settings.source | default: 'collection'
  assign list_collection = section.settings.collection
  assign limit = section.settings.products_to_show

  assign is_recommendations = false
  if source == 'related' or source == 'complementary'
    assign is_recommendations = true
  endif

  assign exclude_id = 0
  if product != blank
    assign exclude_id = product.id
  endif

  if source == 'product_collection' and product != blank
    assign auto_collection = blank
    if collection != blank and collection.handle != 'all' and collection.handle != 'frontpage'
      assign auto_collection = collection
    else
      for product_collection in product.collections
        if product_collection.handle != 'all' and product_collection.handle != 'frontpage' and product_collection.products_count > 1
          assign auto_collection = product_collection
          break
        endif
      endfor
    endif
    if auto_collection != blank
      assign list_collection = auto_collection
    endif
  endif

  assign list_products = blank
  assign reco_performed = false
  if is_recommendations
    if recommendations.performed? and recommendations.products_count > 0
      assign list_products = recommendations.products
      assign reco_performed = true
    endif
  elsif list_collection != blank and list_collection.products_count > 0
    assign list_products = list_collection.products
  endif

  # «[categoria]» en el título se sustituye por el nombre de la colección
  assign section_title = section.settings.title
  if list_collection != blank
    assign section_title = section_title | replace: '[categoria]', list_collection.title | replace: '[categoría]', list_collection.title
  else
    assign section_title = section_title | replace: '[categoria]', '' | replace: '[categoría]', '' | strip
  endif

  assign link_url = section.settings.link_url
  if link_url == blank and list_collection != blank and is_recommendations == false
    assign link_url = list_collection.url
  endif

  assign heading_link_label = blank
  if section.settings.link_position == 'heading'
    assign heading_link_label = section.settings.link_label
  endif

  assign hover_scale = section.settings.hover_zoom | divided_by: 100.0

  # Fuera del editor, una sección sin productos no se muestra.
  # Las recomendaciones se piden después de cargar la página (esqueleto mientras tanto).
  assign hide_section = false
  if is_recommendations
    if product == blank and reco_performed == false and request.design_mode == false
      assign hide_section = true
    endif
  elsif list_products == blank and request.design_mode == false
    assign hide_section = true
  endif
%}

{%- unless hide_section -%}
  {%- if is_recommendations -%}
    <saucha-recommendations
      class="saucha-products-reco"
      {% unless reco_performed %}
        data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit={{ limit | plus: 1 }}&section_id={{ section.id }}&intent={{ source }}"
      {% endunless %}
    >
  {%- endif -%}
  <section
    id="ProductosSaucha-{{ section.id }}"
    class="
      s-section s-scheme-{{ section.settings.scheme }}
      s-pt-{{ section.settings.spacing_top }} s-pb-{{ section.settings.spacing_bottom }}
      saucha-products saucha-products--mobile-{{ section.settings.mobile_layout }}
    "
  >
    <div class="s-container">
      {% render 'saucha-heading',
        eyebrow: section.settings.eyebrow,
        title: section_title,
        text: section.settings.text,
        alignment: section.settings.heading_alignment,
        link_label: heading_link_label,
        link_url: link_url
      %}

      <saucha-collection
        class="saucha-products__collection"
        data-section-id="{{ section.id }}"
        data-card-alignment="{{ section.settings.card_alignment }}"
        data-title-font="heading"
        style="
          --saucha-image-radius: var(--s-radius-media);
          --saucha-hover-scale: {{ hover_scale }};
          --sp-columns: {{ section.settings.columns_desktop }};
        "
      >
        <ul class="saucha-products__list" role="list">
          {%- if list_products != blank -%}
            {%- assign shown = 0 -%}
            {%- for list_product in list_products -%}
              {%- if list_product.id == exclude_id -%}{%- continue -%}{%- endif -%}
              {%- if shown >= limit -%}{%- break -%}{%- endif -%}
              {%- liquid
                assign card_loading = 'lazy'
                if section.index <= 2 and shown < 2
                  assign card_loading = 'eager'
                endif
              -%}
              <li class="saucha-products__item" data-s-reveal="up" style="--s-i: {{ shown }};">
                {% render 'saucha-product-card', product: list_product, section: section, loading: card_loading, fetchpriority: 'auto' %}
              </li>
              {%- assign shown = shown | plus: 1 -%}
            {%- endfor -%}
          {%- elsif is_recommendations and request.design_mode == false -%}
            {%- for i in (1..4) -%}
              <li class="saucha-products__item saucha-products__item--skeleton" aria-hidden="true">
                <span class="saucha-products__skeleton-media"></span>
                <span class="saucha-products__skeleton-line"></span>
                <span class="saucha-products__skeleton-line saucha-products__skeleton-line--short"></span>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <li class="saucha-products__item">
                <article class="saucha-product-card">
                  <div class="saucha-product-card__media" style="--saucha-card-ratio: 3 / 4;">
                    <div class="saucha-product-card__placeholder">{{ 'product-apparel-' | append: i | placeholder_svg_tag }}</div>
                  </div>
                  <div class="saucha-product-card__info">
                    <h3 class="saucha-product-card__title">Nombre del producto</h3>
                    <div class="saucha-product-card__price"><span class="saucha-product-card__price-current">39,00 €</span></div>
                  </div>
                </article>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </saucha-collection>

      {%- if section.settings.link_position == 'bottom' and section.settings.link_label != blank and link_url != blank -%}
        <div class="saucha-products__footer" data-s-reveal="up">
          <a class="button-secondary" href="{{ link_url }}">{{ section.settings.link_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>
  {%- if is_recommendations -%}
    </saucha-recommendations>
  {%- endif -%}
{%- endunless -%}

{%- if is_recommendations -%}
  <script>
    /* Recomendaciones de Shopify: se piden al acercarse a la sección y sustituyen al esqueleto.
       Si no hay ninguna, la sección desaparece. */
    (() => {
      if (customElements.get('saucha-recommendations')) return;

      class SauchaRecommendations extends HTMLElement {
        connectedCallback() {
          if (!this.dataset.url || this.dataset.loading) return;
          if (!('IntersectionObserver' in window)) {
            this.load();
            return;
          }
          this.observer = new IntersectionObserver(
            (entries) => {
              if (!entries.some((entry) => entry.isIntersecting)) return;
              this.observer.disconnect();
              this.load();
            },
            { rootMargin: '0px 0px 600px 0px' }
          );
          this.observer.observe(this);
        }

        disconnectedCallback() {
          this.observer?.disconnect();
        }

        async load() {
          this.dataset.loading = 'true';
          try {
            const response = await fetch(this.dataset.url);
            const html = new DOMParser().parseFromString(await response.text(), 'text/html');
            const incoming = html.querySelector('saucha-recommendations');
            const hasProducts = incoming?.querySelector('.saucha-products__item:not(.saucha-products__item--skeleton)');
            if (!incoming || !hasProducts) {
              this.hide();
              return;
            }

            this.classList.add('is-swapping');
            this.innerHTML = incoming.innerHTML;
            this.removeAttribute('data-url');
            window.SauchaMotion?.scan(this);
            requestAnimationFrame(() => {
              requestAnimationFrame(() => this.classList.remove('is-swapping'));
            });
          } catch (error) {
            this.hide();
          }
        }

        hide() {
          const section = this.closest('.shopify-section');
          (section || this).setAttribute('hidden', '');
        }
      }

      customElements.define('saucha-recommendations', SauchaRecommendations);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* Productos Saucha: la misma tarjeta que la página de colección, en rejilla o carril */

  .saucha-products saucha-collection {
    background: transparent;
  }

  .saucha-products__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-space-8) var(--s-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Móvil · carril con asomo de la siguiente tarjeta */
  @media screen and (max-width: 749px) {
    .saucha-products--mobile-rail .saucha-products__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 68%;
      gap: var(--s-space-3);
      margin-inline: calc(var(--s-gutter) * -1);
      padding-inline: var(--s-gutter);
      scroll-padding-inline: var(--s-gutter);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .saucha-products--mobile-rail .saucha-products__list::-webkit-scrollbar {
      display: none;
    }

    .saucha-products--mobile-rail .saucha-products__item {
      scroll-snap-align: start;
    }
  }

  @media screen and (min-width: 750px) {
    .saucha-products__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-space-12) var(--s-space-5);
    }
  }

  @media screen and (min-width: 1200px) {
    .saucha-products__list {
      grid-template-columns: repeat(var(--sp-columns, 4), minmax(0, 1fr));
      column-gap: var(--s-space-6);
    }
  }

  .saucha-products__item {
    min-width: 0;
  }

  .saucha-products__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--s-heading-gap);
  }

  /* Esqueleto mientras llegan las recomendaciones: mismas proporciones que la tarjeta */
  .saucha-products__item--skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--s-space-2);
  }

  .saucha-products__skeleton-media,
  .saucha-products__skeleton-line {
    display: block;
    border-radius: var(--s-radius-media);
    background: linear-gradient(
        100deg,
        var(--s-color-cream) 40%,
        rgb(var(--s-color-surface-rgb) / 0.9) 50%,
        var(--s-color-cream) 60%
      )
      0 0 / 220% 100%;
    animation: saucha-skeleton 1.6s var(--s-ease-inout) infinite;
  }

  .saucha-products__skeleton-media {
    aspect-ratio: 3 / 4;
    margin-block-end: var(--s-space-2);
  }

  .saucha-products__skeleton-line {
    width: 70%;
    height: 12px;
    margin-inline: auto;
  }

  .saucha-products__skeleton-line--short {
    width: 36%;
  }

  @keyframes saucha-skeleton {
    to {
      background-position: -120% 0;
    }
  }

  .saucha-products-reco {
    display: block;
    transition: opacity var(--s-dur-enter) var(--s-ease);
  }

  .saucha-products-reco.is-swapping {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .saucha-products__skeleton-media,
    .saucha-products__skeleton-line {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Productos Saucha",
  "tag": "div",
  "class": "saucha-products-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Recién llegados"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Título",
      "default": "Novedades"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Productos",
      "options": [
        { "value": "collection", "label": "Colección elegida" },
        { "value": "product_collection", "label": "Categoría del producto (ficha)" },
        { "value": "related", "label": "Relacionados de Shopify (ficha)" },
        { "value": "complementary", "label": "Complementarios de Shopify (ficha)" }
      ],
      "default": "collection",
      "info": "Las opciones «(ficha)» usan el producto que se está viendo y se ocultan si no hay productos. En el título, [categoria] se sustituye por el nombre de la colección."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección",
      "info": "Con «Categoría del producto» solo se usa si el producto no pertenece a ninguna colección."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Número de productos",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Ver toda la colección"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Enlace",
      "info": "Si lo dejas vacío, lleva a la colección elegida."
    },
    {
      "type": "select",
      "id": "link_position",
      "label": "Posición del enlace",
      "options": [
        { "value": "bottom", "label": "Botón bajo los productos" },
        { "value": "heading", "label": "Junto al título" },
        { "value": "none", "label": "Ocultar" }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "Composición"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alineación del título",
      "options": [
        { "value": "center", "label": "Centrado" },
        { "value": "split", "label": "Izquierda con enlace a la derecha" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columnas · escritorio",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Disposición · móvil",
      "options": [
        { "value": "rail", "label": "Carril deslizable" },
        { "value": "grid", "label": "Rejilla de 2 columnas" }
      ],
      "default": "rail"
    },
    {
      "type": "header",
      "content": "Tarjeta de producto",
      "info": "Mismas opciones que la página de colección."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de imagen",
      "options": [
        { "value": "editorial", "label": "Editorial 3:4" },
        { "value": "portrait", "label": "Retrato 2:3" },
        { "value": "square", "label": "Cuadrada" },
        { "value": "adapt", "label": "Original" }
      ],
      "default": "editorial"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Alineación del texto",
      "options": [
        { "value": "center", "label": "Centrado" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "enable_second_image",
      "label": "Segunda imagen al pasar el ratón",
      "default": true
    },
    {
      "type": "range",
      "id": "hover_zoom",
      "label": "Zoom al pasar el ratón",
      "min": 100,
      "max": 106,
      "step": 1,
      "unit": "%",
      "default": 102
    },
    {
      "type": "checkbox",
      "id": "smart_color_media",
      "label": "Imagen según color seleccionado",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Mostrar colores",
      "default": true
    },
    {
      "type": "range",
      "id": "max_swatches",
      "label": "Máximo de colores visibles",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Mostrar marca",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_compare_at",
      "label": "Mostrar precio anterior",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Etiqueta de rebaja",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Texto de rebaja",
      "default": "Rebaja"
    },
    {
      "type": "checkbox",
      "id": "show_sold_out_badge",
      "label": "Etiqueta de agotado",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_new_badge",
      "label": "Etiqueta «Nuevo»",
      "info": "Productos con la etiqueta «nuevo» o publicados hace pocos días. No aparece si ya hay etiqueta de rebaja o agotado.",
      "default": true
    },
    {
      "type": "text",
      "id": "new_label",
      "label": "Texto de «Nuevo»",
      "default": "Nuevo",
      "visible_if": "{{ section.settings.show_new_badge }}"
    },
    {
      "type": "range",
      "id": "new_days",
      "label": "Nuevo durante (días desde su publicación)",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "d",
      "default": 30,
      "visible_if": "{{ section.settings.show_new_badge }}"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Texto de agotado",
      "default": "Agotado"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Marfil (principal)" },
        { "value": "cream", "label": "Crema (alterno)" },
        { "value": "blush", "label": "Blush nude" }
      ],
      "default": "surface"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Espacio superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Productos Saucha",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
