{% liquid
  assign current_collection = collection

  assign desktop_image = section.settings.image_desktop
  assign mobile_image = section.settings.image_mobile

  if desktop_image == blank and current_collection != blank and current_collection.image != blank
    assign desktop_image = current_collection.image
  endif

  if mobile_image == blank
    assign mobile_image = desktop_image
  endif

  assign hero_title = current_collection.title

  if hero_title == blank
    assign hero_title = section.settings.fallback_title
  endif
%}

<section
  id="CollectionHeroSaucha-{{ section.id }}"
  class="saucha-collection-hero"
  style="
    --sch-bg-overlay: {{ section.settings.overlay_color }};
    --sch-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};

    --sch-text-color: {{ section.settings.text_color }};
    --sch-breadcrumb-color: {{ section.settings.breadcrumb_color }};

    --sch-max-width: {{ section.settings.max_width }}px;

    --sch-height-desktop: {{ section.settings.hero_height_desktop }}px;
    --sch-height-mobile: {{ section.settings.hero_height_mobile }}px;

    --sch-side-padding-desktop: {{ section.settings.side_padding_desktop }}px;
    --sch-side-padding-mobile: {{ section.settings.side_padding_mobile }}px;

    --sch-header-offset-desktop: {{ section.settings.header_offset_desktop }}px;
    --sch-header-offset-mobile: {{ section.settings.header_offset_mobile }}px;

    --sch-breadcrumb-top-desktop: {{ section.settings.breadcrumb_top_desktop }}px;
    --sch-breadcrumb-top-mobile: {{ section.settings.breadcrumb_top_mobile }}px;

    --sch-title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --sch-title-size-mobile: {{ section.settings.title_size_mobile }}px;

    --sch-title-line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};

    --sch-breadcrumb-size-desktop: {{ section.settings.breadcrumb_size_desktop }}px;
    --sch-breadcrumb-size-mobile: {{ section.settings.breadcrumb_size_mobile }}px;

    --sch-image-x-desktop: {{ section.settings.image_x_desktop }}%;
    --sch-image-y-desktop: {{ section.settings.image_y_desktop }}%;

    --sch-image-x-mobile: {{ section.settings.image_x_mobile }}%;
    --sch-image-y-mobile: {{ section.settings.image_y_mobile }}%;
  "
>
  <div class="saucha-collection-hero__media">

    {% if desktop_image != blank %}
      <picture class="saucha-collection-hero__picture">

        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 480 }} 480w,
              {{ mobile_image | image_url: width: 720 }} 720w,
              {{ mobile_image | image_url: width: 960 }} 960w,
              {{ mobile_image | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {% endif %}

        {{
          desktop_image
          | image_url: width: 2400
          | image_tag:
            widths: '640, 900, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            class: 'saucha-collection-hero__image'
        }}
      </picture>
    {% else %}
      <div class="saucha-collection-hero__placeholder">
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}

    <div class="saucha-collection-hero__overlay"></div>
  </div>

  <div class="saucha-collection-hero__content">
    <div class="saucha-collection-hero__inner">

      <div class="saucha-collection-hero__breadcrumb">
        <a href="{{ routes.root_url }}">
          {{ section.settings.home_label | escape }}
        </a>

        <span class="saucha-collection-hero__breadcrumb-separator">
          {{ section.settings.separator | escape }}
        </span>

        <span aria-current="page">
          {{ hero_title | escape }}
        </span>
      </div>

      <div class="saucha-collection-hero__title-wrap">
        <h1 class="saucha-collection-hero__title">
          {{ hero_title | escape }}
        </h1>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}

  /* =========================================================
     SAUCHA · COLLECTION HERO
     ========================================================= */

  .saucha-collection-hero,
  .saucha-collection-hero * {
    box-sizing: border-box;
  }


  .saucha-collection-hero {
    position: relative;
    width: 100%;
    min-height: var(--sch-height-desktop);
    color: var(--sch-text-color);
    overflow: hidden;
  }


  /* =========================================================
     FONDO
     ========================================================= */

  .saucha-collection-hero__media,
  .saucha-collection-hero__picture,
  .saucha-collection-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }


  .saucha-collection-hero__image,
  .saucha-collection-hero__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }


  .saucha-collection-hero__image {
    object-fit: cover;
    object-position:
      var(--sch-image-x-desktop)
      var(--sch-image-y-desktop);
  }


  .saucha-collection-hero__placeholder {
    background: rgba(0, 0, 0, 0.08);
  }


  .saucha-collection-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--sch-bg-overlay);
    opacity: var(--sch-overlay-opacity);
    pointer-events: none;
  }


  /* =========================================================
     CONTENIDO
     ========================================================= */

  .saucha-collection-hero__content {
    position: relative;
    z-index: 2;
    min-height: var(--sch-height-desktop);
  }


.saucha-collection-hero__inner {
  width: min(100%, var(--sch-max-width));
  min-height: var(--sch-height-desktop);

  margin-inline: auto;

  padding-inline:
    var(--sch-side-padding-desktop);

  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;
}

  /* =========================================================
     BREADCRUMB
     ========================================================= */

.saucha-collection-hero__breadcrumb {
  position: absolute;

  top:
    calc(
      var(--sch-header-offset-desktop)
      + var(--sch-breadcrumb-top-desktop)
    );

  left:
    var(--sch-side-padding-desktop);

  right:
    var(--sch-side-padding-desktop);

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 8px;

  width: auto;

  color:
    var(--sch-breadcrumb-color);

  font-family:
    var(--font-body--family);

  font-size:
    var(--sch-breadcrumb-size-desktop);

  line-height: 1.2;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  text-align: center;

  z-index: 3;
}


  .saucha-collection-hero__breadcrumb a,
  .saucha-collection-hero__breadcrumb span {
    color: inherit;
    text-decoration: none;
  }


  .saucha-collection-hero__breadcrumb a {
    transition: opacity 180ms ease;
  }


  .saucha-collection-hero__breadcrumb a:hover {
    opacity: 0.7;
  }


  .saucha-collection-hero__breadcrumb-separator {
    opacity: 0.8;
  }


  /* =========================================================
     TÍTULO
     ========================================================= */

  .saucha-collection-hero__title-wrap {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }


  .saucha-collection-hero__title {
    margin: 0;
    color: var(--sch-text-color);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: var(--sch-title-size-desktop);
    line-height: var(--sch-title-line-height);
    letter-spacing: -0.02em;
    text-align: center;
    text-wrap: balance;
  }


  /* =========================================================
     MÓVIL
     ========================================================= */

  @media screen and (max-width: 749px) {

    .saucha-collection-hero {
      min-height: var(--sch-height-mobile);
    }


    .saucha-collection-hero__content,
    .saucha-collection-hero__inner {
      min-height: var(--sch-height-mobile);
    }


    .saucha-collection-hero__inner {
      padding-inline: var(--sch-side-padding-mobile);
      padding-top: var(--sch-header-offset-mobile);
    }


    .saucha-collection-hero__image {
      object-position:
        var(--sch-image-x-mobile)
        var(--sch-image-y-mobile);
    }


    .saucha-collection-hero__breadcrumb {
      top: calc(
        var(--sch-header-offset-mobile) +
        var(--sch-breadcrumb-top-mobile)
      );
      left: var(--sch-side-padding-mobile);
      right: var(--sch-side-padding-mobile);

      gap: 6px;
      font-size: var(--sch-breadcrumb-size-mobile);
      line-height: 1.2;
      letter-spacing: 0.1em;

      flex-wrap: wrap;
    }


    .saucha-collection-hero__title {
      font-size: var(--sch-title-size-mobile);
    }
  }


  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .saucha-collection-hero__breadcrumb a {
      transition: none;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Hero colección",

  "enabled_on": {
    "templates": [
      "collection"
    ]
  },

  "settings": [

    {
      "type": "header",
      "content": "Contenido"
    },

    {
      "type": "text",
      "id": "fallback_title",
      "label": "Título de fallback",
      "default": "Colección",
      "info": "Solo se usa si por algún motivo no existe el título de la colección."
    },

    {
      "type": "text",
      "id": "home_label",
      "label": "Texto de inicio",
      "default": "Home"
    },

    {
      "type": "text",
      "id": "separator",
      "label": "Separador del breadcrumb",
      "default": "/"
    },


    {
      "type": "header",
      "content": "Imagen"
    },

    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen · escritorio",
      "info": "Si no eliges una imagen, usará la imagen de la colección si existe."
    },

    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen · móvil"
    },

    {
      "type": "range",
      "id": "image_x_desktop",
      "label": "Imagen X · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_y_desktop",
      "label": "Imagen Y · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_x_mobile",
      "label": "Imagen X · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_y_mobile",
      "label": "Imagen Y · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },


    {
      "type": "header",
      "content": "Tamaño y estructura"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo del contenido",
      "min": 1200,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1800
    },

    {
      "type": "range",
      "id": "hero_height_desktop",
      "label": "Altura del hero · escritorio",
      "min": 220,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 320
    },

    {
      "type": "range",
      "id": "hero_height_mobile",
      "label": "Altura del hero · móvil",
      "min": 180,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 260
    },

    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Margen lateral · escritorio",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Margen lateral · móvil",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },

    {
      "type": "range",
      "id": "header_offset_desktop",
      "label": "Separación para compensar el header · escritorio",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 28
    },

    {
      "type": "range",
      "id": "header_offset_mobile",
      "label": "Separación para compensar el header · móvil",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 18
    },

    {
      "type": "range",
      "id": "breadcrumb_top_desktop",
      "label": "Posición vertical del breadcrumb · escritorio",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "breadcrumb_top_mobile",
      "label": "Posición vertical del breadcrumb · móvil",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },


    {
      "type": "header",
      "content": "Tipografía"
    },

    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Título · escritorio",
      "min": 30,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 54
    },

    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Título · móvil",
      "min": 24,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 38
    },

    {
      "type": "range",
      "id": "title_line_height",
      "label": "Interlineado del título",
      "min": 80,
      "max": 130,
      "step": 1,
      "unit": "%",
      "default": 100
    },

    {
      "type": "range",
      "id": "breadcrumb_size_desktop",
      "label": "Breadcrumb · escritorio",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "breadcrumb_size_mobile",
      "label": "Breadcrumb · móvil",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },


    {
      "type": "header",
      "content": "Colores"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Color del título",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "breadcrumb_color",
      "label": "Color del breadcrumb",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color de superposición",
      "default": "#000000"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad de superposición",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 28
    }

  ],

  "presets": [
    {
      "name": "Hero colección"
    }
  ]
}
{% endschema %}