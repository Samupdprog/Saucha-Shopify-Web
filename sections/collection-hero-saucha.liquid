{% liquid
  assign current_collection = collection

  assign hero_title = current_collection.title | default: section.settings.fallback_title

  # Imagen: la de la colección manda; la de la sección es el respaldo común
  assign desktop_image = blank
  assign mobile_image = blank
  if section.settings.use_collection_image and current_collection.image != blank
    assign desktop_image = current_collection.image
  endif
  if desktop_image == blank
    assign desktop_image = section.settings.image_desktop
    assign mobile_image = section.settings.image_mobile
  endif

  assign has_image = false
  if section.settings.layout == 'image' and desktop_image != blank
    assign has_image = true
  endif

  assign description = current_collection.description | strip_html | strip
  assign product_count = current_collection.products_count | default: 0
%}

<section
  id="CollectionHeroSaucha-{{ section.id }}"
  class="
    saucha-collection-hero
    saucha-collection-hero--{% if has_image %}image s-on-media{% else %}plain s-section s-scheme-{{ section.settings.scheme }} s-pt-md s-pb-sm{% endif %}
    saucha-collection-hero--align-{{ section.settings.alignment }}
  "
  {% if has_image %}
    data-header-overlay
    style="
      --sch-h: {{ section.settings.height }};
      --sch-h-m: {{ section.settings.height_mobile }};
    "
  {% endif %}
>
  {%- if has_image -%}
    <div
      class="s-media saucha-collection-hero__media"
      data-s-reveal="media"
      style="
        --s-fx: {{ section.settings.focus_x }}%;
        --s-fy: {{ section.settings.focus_y }}%;
        --s-fx-m: {{ section.settings.focus_x_mobile }}%;
        --s-fy-m: {{ section.settings.focus_y_mobile }}%;
        --s-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
        --s-overlay-direction: to top;
      "
    >
      {% render 'saucha-media',
        image: desktop_image,
        image_mobile: mobile_image,
        loading: 'eager',
        fetchpriority: 'high',
        alt: hero_title
      %}
      <span class="s-media__overlay s-media__overlay--gradient" aria-hidden="true"></span>
    </div>
  {%- endif -%}

  <div class="s-container saucha-collection-hero__content">
    <div class="saucha-collection-hero__copy">
      {%- if section.settings.show_breadcrumb -%}
        <nav class="saucha-collection-hero__breadcrumb s-eyebrow" aria-label="Ruta de navegación" data-s-reveal="fade">
          <a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a>
          <span aria-hidden="true">/</span>
          {%- if section.settings.show_collections_link -%}
            <a href="{{ routes.collections_url }}">{{ section.settings.collections_label | escape }}</a>
            <span aria-hidden="true">/</span>
          {%- endif -%}
          <span aria-current="page">{{ hero_title | escape }}</span>
        </nav>
      {%- endif -%}

      {% render 'saucha-title', text: hero_title, tag: 'h1', size: section.settings.title_size, index: 1 %}

      {%- if section.settings.show_description and description != blank -%}
        <p class="s-text saucha-collection-hero__description" data-s-reveal="up" style="--s-i: 2;">
          {{- description | truncatewords: 40 -}}
        </p>
      {%- endif -%}

      {%- if section.settings.show_count and product_count > 0 -%}
        <p class="s-meta saucha-collection-hero__count" data-s-reveal="fade" style="--s-i: 3;">
          {{ product_count }} {{ product_count | pluralize: 'pieza', 'piezas' }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* Cabecera de colección: fotografía con título superpuesto o versión editorial sin imagen */

  .saucha-collection-hero {
    position: relative;
  }

  .saucha-collection-hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-space-3);
    align-items: center;
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
  }

  .saucha-collection-hero--align-left .saucha-collection-hero__copy {
    align-items: flex-start;
    text-align: left;
    margin-inline: 0;
  }

  .saucha-collection-hero__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-space-2);
    color: var(--s-muted);
  }

  .saucha-collection-hero__breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color var(--s-dur-micro) var(--s-ease);
  }

  .saucha-collection-hero__breadcrumb a:hover {
    color: var(--s-fg);
  }

  .saucha-collection-hero__breadcrumb [aria-current] {
    color: var(--s-fg);
  }

  .saucha-collection-hero__description {
    margin: var(--s-space-1) 0 0;
  }

  .saucha-collection-hero--align-center .saucha-collection-hero__description {
    margin-inline: auto;
  }

  .saucha-collection-hero__count {
    margin: 0;
  }

  /* Con imagen */
  .saucha-collection-hero--image {
    display: grid;
    min-height: var(--sch-h-m, 52svh);
    overflow: hidden;
    isolation: isolate;
  }

  .saucha-collection-hero--image > .saucha-collection-hero__media {
    --s-media-h: 100%;
    --s-media-h-m: 100%;
    --s-media-radius: 0;

    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .saucha-collection-hero--image .saucha-collection-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    /* el header transparente flota encima: el texto nunca queda debajo */
    padding-top: calc(var(--header-height, 64px) + var(--s-space-10));
    padding-bottom: var(--s-space-10);
  }

  .saucha-collection-hero--image .saucha-collection-hero__breadcrumb {
    color: rgb(var(--s-color-surface-rgb) / 0.82);
  }

  @media screen and (min-width: 750px) {
    .saucha-collection-hero--image {
      min-height: var(--sch-h, 60svh);
    }

    .saucha-collection-hero--image .saucha-collection-hero__content {
      padding-bottom: var(--s-space-16);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cabecera de colección",
  "tag": "div",
  "class": "saucha-collection-hero-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Estilo",
      "options": [
        { "value": "image", "label": "Fotografía con título encima" },
        { "value": "plain", "label": "Editorial sin imagen" }
      ],
      "default": "image",
      "info": "Sin imagen, el header se muestra sólido automáticamente."
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "display", "label": "Muy grande" },
        { "value": "h1", "label": "Grande" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación",
      "options": [
        { "value": "center", "label": "Centrada" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Ruta de navegación",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Texto de inicio",
      "default": "Inicio",
      "visible_if": "{{ section.settings.show_breadcrumb }}"
    },
    {
      "type": "checkbox",
      "id": "show_collections_link",
      "label": "Incluir «Colecciones» en la ruta",
      "default": true,
      "visible_if": "{{ section.settings.show_breadcrumb }}"
    },
    {
      "type": "text",
      "id": "collections_label",
      "label": "Texto de colecciones",
      "default": "Colecciones",
      "visible_if": "{{ section.settings.show_breadcrumb and section.settings.show_collections_link }}"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Descripción de la colección",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Número de piezas",
      "default": false
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Título de respaldo",
      "default": "Colección"
    },
    {
      "type": "header",
      "content": "Imagen",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "use_collection_image",
      "label": "Usar la imagen de cada colección",
      "default": true,
      "info": "Se edita en Productos › Colecciones. Si una colección no tiene imagen se usan las de abajo.",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen de respaldo · escritorio",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen de respaldo · móvil",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Encuadre horizontal · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Encuadre vertical · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "range",
      "id": "focus_x_mobile",
      "label": "Encuadre horizontal · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "range",
      "id": "focus_y_mobile",
      "label": "Encuadre vertical · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Velo oscuro bajo el texto",
      "min": 0,
      "max": 70,
      "step": 2,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Altura · escritorio",
      "options": [
        { "value": "45svh", "label": "Baja" },
        { "value": "60svh", "label": "Media" },
        { "value": "75svh", "label": "Alta" }
      ],
      "default": "60svh",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Altura · móvil",
      "options": [
        { "value": "40svh", "label": "Baja" },
        { "value": "52svh", "label": "Media" },
        { "value": "68svh", "label": "Alta" }
      ],
      "default": "52svh",
      "visible_if": "{{ section.settings.layout == 'image' }}"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Marfil (principal)" },
        { "value": "cream", "label": "Crema (alterno)" },
        { "value": "blush", "label": "Blush nude" }
      ],
      "default": "surface",
      "visible_if": "{{ section.settings.layout == 'plain' }}"
    }
  ],
  "presets": [
    {
      "name": "Cabecera de colección",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
