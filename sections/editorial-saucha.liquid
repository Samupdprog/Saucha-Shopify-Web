{% liquid
  assign desktop_image = section.settings.image_desktop
  assign mobile_image = section.settings.image_mobile

  if desktop_image == blank and mobile_image != blank
    assign desktop_image = mobile_image
  endif

  if mobile_image == blank
    assign mobile_image = desktop_image
  endif

  assign image_share = section.settings.image_width_desktop
  assign text_share = 100 | minus: image_share

  case section.settings.text_alignment
    when 'left'
      assign desktop_align_items = 'flex-start'
      assign desktop_button_justify = 'flex-start'

    when 'right'
      assign desktop_align_items = 'flex-end'
      assign desktop_button_justify = 'flex-end'

    else
      assign desktop_align_items = 'center'
      assign desktop_button_justify = 'center'
  endcase

  case section.settings.text_alignment_mobile
    when 'left'
      assign mobile_align_items = 'flex-start'
      assign mobile_button_justify = 'flex-start'

    when 'right'
      assign mobile_align_items = 'flex-end'
      assign mobile_button_justify = 'flex-end'

    else
      assign mobile_align_items = 'center'
      assign mobile_button_justify = 'center'
  endcase
%}

<section
  id="EditorialSaucha-{{ section.id }}"
  class="
    saucha-editorial
    saucha-editorial--image-{{ section.settings.image_side }}
    saucha-editorial--mobile-{{ section.settings.mobile_order }}
  "
  style="
    --se-bg: {{ section.settings.background_color }};
    --se-title-color: {{ section.settings.title_color }};
    --se-text-color: {{ section.settings.text_color }};

    --se-max-width: {{ section.settings.max_width }}px;

    --se-side-padding-desktop:
      {{ section.settings.side_padding_desktop }}px;

    --se-side-padding-mobile:
      {{ section.settings.side_padding_mobile }}px;

    --se-column-gap:
      {{ section.settings.column_gap }}px;

    --se-padding-top:
      {{ section.settings.padding_top }}px;

    --se-padding-bottom:
      {{ section.settings.padding_bottom }}px;

    --se-padding-top-mobile:
      {{ section.settings.padding_top_mobile }}px;

    --se-padding-bottom-mobile:
      {{ section.settings.padding_bottom_mobile }}px;

    --se-image-share: {{ image_share }}fr;
    --se-text-share: {{ text_share }}fr;

    --se-image-height-desktop:
      {{ section.settings.image_height_desktop }}px;

    --se-image-height-mobile:
      {{ section.settings.image_height_mobile }}px;

    --se-image-x-desktop:
      {{ section.settings.image_x_desktop }}%;

    --se-image-y-desktop:
      {{ section.settings.image_y_desktop }}%;

    --se-image-x-mobile:
      {{ section.settings.image_x_mobile }}%;

    --se-image-y-mobile:
      {{ section.settings.image_y_mobile }}%;

    --se-image-radius:
      {{ section.settings.image_radius }}px;

    --se-title-font:
      var(--font-{{ section.settings.title_font }}--family);

    --se-title-weight:
      var(
        --font-{{ section.settings.title_font }}--weight,
        400
      );

    --se-text-font:
      var(--font-{{ section.settings.text_font }}--family);

    --se-text-weight:
      var(
        --font-{{ section.settings.text_font }}--weight,
        400
      );

    --se-title-size-desktop:
      {{ section.settings.title_size_desktop }}px;

    --se-title-size-mobile:
      {{ section.settings.title_size_mobile }}px;

    --se-text-size-desktop:
      {{ section.settings.text_size_desktop }}px;

    --se-text-size-mobile:
      {{ section.settings.text_size_mobile }}px;

    --se-title-line-height:
      {{ section.settings.title_line_height | divided_by: 100.0 }};

    --se-text-line-height:
      {{ section.settings.text_line_height | divided_by: 100.0 }};

    --se-title-max-width:
      {{ section.settings.title_max_width }}px;

    --se-text-max-width:
      {{ section.settings.text_max_width }}px;

    --se-title-text-gap:
      {{ section.settings.title_text_gap }}px;

    --se-divider-height:
      {{ section.settings.divider_height }}px;

    --se-divider-gap-top:
      {{ section.settings.divider_gap_top }}px;

    --se-divider-gap-bottom:
      {{ section.settings.divider_gap_bottom }}px;

    --se-divider-color:
      {{ section.settings.divider_color }};

    --se-vertical-alignment:
      {{ section.settings.vertical_alignment }};

    --se-text-align-desktop:
      {{ section.settings.text_alignment }};

    --se-text-align-mobile:
      {{ section.settings.text_alignment_mobile }};

    --se-align-items-desktop:
      {{ desktop_align_items }};

    --se-align-items-mobile:
      {{ mobile_align_items }};

    --se-button-justify-desktop:
      {{ desktop_button_justify }};

    --se-button-justify-mobile:
      {{ mobile_button_justify }};
  "
>
  <div class="saucha-editorial__inner">

    <div class="saucha-editorial__copy">
      <div class="saucha-editorial__copy-inner">

        {% if section.settings.title != blank %}
          <h2 class="saucha-editorial__title">
            {{
              section.settings.title
              | escape
              | newline_to_br
            }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="saucha-editorial__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.show_divider %}
          <span
            class="saucha-editorial__divider"
            aria-hidden="true"
          ></span>
        {% endif %}

        {% if section.settings.show_button %}
          <div class="saucha-editorial__button">
            {% content_for 'block',
              type: 'button',
              id: 'button'
            %}
          </div>
        {% endif %}

      </div>
    </div>

    <div class="saucha-editorial__media">

      {% if desktop_image != blank %}

        <picture class="saucha-editorial__picture">

          {% if mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 480 }} 480w,
                {{ mobile_image | image_url: width: 720 }} 720w,
                {{ mobile_image | image_url: width: 960 }} 960w,
                {{ mobile_image | image_url: width: 1200 }} 1200w
              "
              sizes="100vw"
            >
          {% endif %}

          {{
            desktop_image
            | image_url: width: 2400
            | image_tag:
              widths: '640, 900, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 900px) 55vw, 100vw',
              loading: 'lazy',
              class: 'saucha-editorial__image'
          }}

        </picture>

      {% else %}

        <div class="saucha-editorial__placeholder">
          {{
            'lifestyle-1'
            | placeholder_svg_tag: 'placeholder-svg'
          }}
        </div>

      {% endif %}

    </div>

  </div>
</section>

{% stylesheet %}

  /* =========================================================
     SAUCHA · EDITORIAL IMAGE + TEXT
     ========================================================= */

  .saucha-editorial,
  .saucha-editorial * {
    box-sizing: border-box;
  }

  .saucha-editorial {
    width: 100%;
    background: var(--se-bg);
    color: var(--se-title-color);
  }


  /* =========================================================
     ESTRUCTURA
     ========================================================= */

  .saucha-editorial__inner {
    width: 100%;
    max-width: var(--se-max-width);
    margin-inline: auto;

    padding:
      var(--se-padding-top)
      var(--se-side-padding-desktop)
      var(--se-padding-bottom);

    display: grid;
    gap: var(--se-column-gap);

    align-items: stretch;
  }


  /* =========================================================
     IMAGEN A LA DERECHA
     ========================================================= */

  .saucha-editorial--image-right
    .saucha-editorial__inner {

    grid-template-columns:
      minmax(0, var(--se-text-share))
      minmax(0, var(--se-image-share));
  }

  .saucha-editorial--image-right
    .saucha-editorial__copy {

    grid-column: 1;
    grid-row: 1;
  }

  .saucha-editorial--image-right
    .saucha-editorial__media {

    grid-column: 2;
    grid-row: 1;
  }


  /* =========================================================
     IMAGEN A LA IZQUIERDA
     ========================================================= */

  .saucha-editorial--image-left
    .saucha-editorial__inner {

    grid-template-columns:
      minmax(0, var(--se-image-share))
      minmax(0, var(--se-text-share));
  }

  .saucha-editorial--image-left
    .saucha-editorial__media {

    grid-column: 1;
    grid-row: 1;
  }

  .saucha-editorial--image-left
    .saucha-editorial__copy {

    grid-column: 2;
    grid-row: 1;
  }


  /* =========================================================
     CONTENIDO
     ========================================================= */

.saucha-editorial__copy {
  min-width: 0;
  min-height: var(--se-image-height-desktop);

  display: flex;
  flex-direction: column;

  justify-content:
    var(--se-vertical-alignment);
}

  .saucha-editorial__copy-inner {
    width: 100%;

    display: flex;
    flex-direction: column;

    align-items:
      var(--se-align-items-desktop);

    text-align:
      var(--se-text-align-desktop);
  }


  /* =========================================================
     TÍTULO
     ========================================================= */

  .saucha-editorial__title {
    width:
      min(
        100%,
        var(--se-title-max-width)
      );

    margin: 0;

    color:
      var(--se-title-color);

    font-family:
      var(--se-title-font);

    font-size:
      var(--se-title-size-desktop);

    font-weight:
      var(--se-title-weight);

    line-height:
      var(--se-title-line-height);

    letter-spacing: -0.015em;

    text-wrap: balance;
  }


  /* =========================================================
     TEXTO
     ========================================================= */

  .saucha-editorial__text {
    width:
      min(
        100%,
        var(--se-text-max-width)
      );

    margin-top:
      var(--se-title-text-gap);

    color:
      var(--se-text-color);

    font-family:
      var(--se-text-font);

    font-size:
      var(--se-text-size-desktop);

    font-weight:
      var(--se-text-weight);

    line-height:
      var(--se-text-line-height);

    text-wrap: pretty;
  }

  .saucha-editorial__text > * {
    margin: 0;
  }

  .saucha-editorial__text > * + * {
    margin-top: 0.65em;
  }


  /* =========================================================
     LÍNEA VERTICAL
     ========================================================= */

  .saucha-editorial__divider {
    display: block;

    flex: 0 0 auto;

    width: 1px;

    height:
      var(--se-divider-height);

    margin-top:
      var(--se-divider-gap-top);

    margin-bottom:
      var(--se-divider-gap-bottom);

    background:
      var(--se-divider-color);
  }


  /* =========================================================
     BOTÓN NATIVO DEL TEMA
     ========================================================= */

  .saucha-editorial__button {
    display: flex;

    width: 100%;
    max-width: 100%;

    justify-content:
      var(--se-button-justify-desktop);
  }


  /* =========================================================
     IMAGEN
     ========================================================= */

  .saucha-editorial__media {
    min-width: 0;

    height:
      var(--se-image-height-desktop);

    overflow: hidden;

    border-radius:
      var(--se-image-radius);
  }

  .saucha-editorial__picture,
  .saucha-editorial__placeholder {
    display: block;

    width: 100%;
    height: 100%;
  }

  .saucha-editorial__image,
  .saucha-editorial__placeholder svg {
    display: block;

    width: 100%;
    height: 100%;
  }

  .saucha-editorial__image {
    object-fit: cover;

    object-position:
      var(--se-image-x-desktop)
      var(--se-image-y-desktop);
  }

  .saucha-editorial__placeholder {
    background:
      rgba(0, 0, 0, 0.04);
  }


  /* =========================================================
     MÓVIL
     ========================================================= */

  @media screen and (max-width: 899px) {

    .saucha-editorial__inner,
    .saucha-editorial--image-right
      .saucha-editorial__inner,
    .saucha-editorial--image-left
      .saucha-editorial__inner {

      grid-template-columns:
        minmax(0, 1fr);

      gap: 0;

      padding:
        var(--se-padding-top-mobile)
        var(--se-side-padding-mobile)
        var(--se-padding-bottom-mobile);
    }


    /* Reset del grid desktop */

    .saucha-editorial__copy,
    .saucha-editorial__media,
    .saucha-editorial--image-right
      .saucha-editorial__copy,
    .saucha-editorial--image-right
      .saucha-editorial__media,
    .saucha-editorial--image-left
      .saucha-editorial__copy,
    .saucha-editorial--image-left
      .saucha-editorial__media {

      grid-column: 1;
      grid-row: auto;
    }


    /* Imagen primero */

    .saucha-editorial--mobile-image_first
      .saucha-editorial__media {

      order: 1;
    }

    .saucha-editorial--mobile-image_first
      .saucha-editorial__copy {

      order: 2;
    }


    /* Texto primero */

    .saucha-editorial--mobile-text_first
      .saucha-editorial__copy {

      order: 1;
    }

    .saucha-editorial--mobile-text_first
      .saucha-editorial__media {

      order: 2;
    }


    /* Imagen */

    .saucha-editorial__media {
      height:
        var(--se-image-height-mobile);
    }

    .saucha-editorial__image {
      object-position:
        var(--se-image-x-mobile)
        var(--se-image-y-mobile);
    }


    /* Texto */

    .saucha-editorial__copy {
      min-height: 0;

      padding-block:
        38px 10px;

      justify-content:
        flex-start;
    }

    .saucha-editorial--mobile-text_first
      .saucha-editorial__copy {

      padding-block:
        10px 38px;
    }

    .saucha-editorial__copy-inner {
      align-items:
        var(--se-align-items-mobile);

      text-align:
        var(--se-text-align-mobile);
    }


    /* Tipografía */

    .saucha-editorial__title {
      font-size:
        var(--se-title-size-mobile);
    }

    .saucha-editorial__text {
      font-size:
        var(--se-text-size-mobile);
    }


    /* Línea */

    .saucha-editorial__divider {
      height:
        min(
          var(--se-divider-height),
          56px
        );

      margin-top:
        min(
          var(--se-divider-gap-top),
          28px
        );

      margin-bottom:
        min(
          var(--se-divider-gap-bottom),
          28px
        );
    }


    /* Botón */

    .saucha-editorial__button {
      justify-content:
        var(--se-button-justify-mobile);
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Editorial Saucha",

  "settings": [

    {
      "type": "header",
      "content": "Contenido"
    },

    {
      "type": "textarea",
      "id": "title",
      "label": "Título",
      "default": "Calidad que se siente"
    },

    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Una selección cuidada de prendas pensadas para acompañarte temporada tras temporada.</p>"
    },

    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Mostrar botón",
      "default": true
    },


    {
      "type": "header",
      "content": "Imagen"
    },

    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen · escritorio"
    },

    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen · móvil"
    },

    {
      "type": "select",
      "id": "image_side",
      "label": "Posición de la imagen · escritorio",
      "options": [
        {
          "value": "right",
          "label": "Derecha"
        },
        {
          "value": "left",
          "label": "Izquierda"
        }
      ],
      "default": "right"
    },

    {
      "type": "select",
      "id": "mobile_order",
      "label": "Orden · móvil",
      "options": [
        {
          "value": "image_first",
          "label": "Imagen primero"
        },
        {
          "value": "text_first",
          "label": "Texto primero"
        }
      ],
      "default": "image_first"
    },

    {
      "type": "range",
      "id": "image_width_desktop",
      "label": "Ancho de imagen · escritorio",
      "min": 40,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 52
    },

    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Altura de imagen · escritorio",
      "min": 360,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 640
    },

    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Altura de imagen · móvil",
      "min": 260,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 430
    },

    {
      "type": "range",
      "id": "image_x_desktop",
      "label": "Imagen X · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_y_desktop",
      "label": "Imagen Y · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_x_mobile",
      "label": "Imagen X · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_y_mobile",
      "label": "Imagen Y · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_radius",
      "label": "Redondeado de imagen",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },


    {
      "type": "header",
      "content": "Composición"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo del componente",
      "min": 1100,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "default": 1540
    },

    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Margen lateral · escritorio",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 40
    },

    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Margen lateral · móvil",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },

    {
      "type": "range",
      "id": "column_gap",
      "label": "Separación texto / imagen",
      "min": 20,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior · escritorio",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 52
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior · escritorio",
      "min": 0,
      "max": 180,
      "step": 2,
      "unit": "px",
      "default": 52
    },

    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Espacio superior · móvil",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 28
    },

    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Espacio inferior · móvil",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 28
    },

    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Posición vertical del texto",
      "options": [
        {
          "value": "flex-start",
          "label": "Arriba"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "flex-end",
          "label": "Abajo"
        }
      ],
      "default": "center"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación de texto · escritorio",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },

    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Alineación de texto · móvil",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },


    {
      "type": "header",
      "content": "Tipografía"
    },

    {
      "type": "select",
      "id": "title_font",
      "label": "Fuente del título",
      "options": [
        {
          "value": "heading",
          "label": "Títulos del tema"
        },
        {
          "value": "body",
          "label": "Texto del tema"
        }
      ],
      "default": "heading"
    },

    {
      "type": "select",
      "id": "text_font",
      "label": "Fuente del texto",
      "options": [
        {
          "value": "body",
          "label": "Texto del tema"
        },
        {
          "value": "heading",
          "label": "Títulos del tema"
        }
      ],
      "default": "body"
    },

    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Título · escritorio",
      "min": 30,
      "max": 84,
      "step": 1,
      "unit": "px",
      "default": 48
    },

    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Título · móvil",
      "min": 26,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 36
    },

    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Texto · escritorio",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 18
    },

    {
