{% liquid
  assign image_desktop = section.settings.image_desktop
  assign image_mobile = section.settings.image_mobile

  assign image_share = section.settings.image_width
  assign text_share = 100 | minus: image_share

  assign button_style = section.settings.button_style
  assign has_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign has_button = true
  endif
%}

<section
  id="EditorialSaucha-{{ section.id }}"
  class="
    s-section s-scheme-{{ section.settings.scheme }}
    s-pt-{{ section.settings.spacing_top }} s-pb-{{ section.settings.spacing_bottom }}
    saucha-editorial
    saucha-editorial--image-{{ section.settings.image_side }}
    saucha-editorial--mobile-{{ section.settings.mobile_order }}
    saucha-editorial--align-{{ section.settings.text_alignment }}
    saucha-editorial--align-mobile-{{ section.settings.text_alignment_mobile }}
  "
  style="
    --se-image-share: {{ image_share }}fr;
    --se-text-share: {{ text_share }}fr;
    --se-valign: {{ section.settings.vertical_alignment }};
  "
>
  <div class="s-container saucha-editorial__grid">
    <div
      class="s-media saucha-editorial__media"
      data-s-reveal="media"
      style="
        --s-media-ratio: {{ section.settings.image_ratio }};
        --s-media-ratio-m: {{ section.settings.image_ratio_mobile }};
        --s-fx: {{ section.settings.focus_x }}%;
        --s-fy: {{ section.settings.focus_y }}%;
        --s-fx-m: {{ section.settings.focus_x_mobile }}%;
        --s-fy-m: {{ section.settings.focus_y_mobile }}%;
      "
    >
      {% render 'saucha-media',
        image: image_desktop,
        image_mobile: image_mobile,
        sizes: '(min-width: 1200px) 50vw, (min-width: 750px) 55vw, 100vw',
        alt: section.settings.title
      %}
    </div>

    <div class="saucha-editorial__copy">
      <div class="saucha-editorial__copy-inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="s-eyebrow" data-s-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {% render 'saucha-title', text: section.settings.title, size: section.settings.title_size, index: 1 %}

        {%- if section.settings.text != blank -%}
          <div class="s-text saucha-editorial__text" data-s-reveal="up" style="--s-i: 2;">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_divider -%}
          <span class="saucha-editorial__divider" aria-hidden="true" data-s-reveal="fade" style="--s-i: 3;"></span>
        {%- endif -%}

        {%- if has_button -%}
          <div class="saucha-editorial__action" data-s-reveal="up" style="--s-i: 4;">
            {%- if button_style == 'link' -%}
              <a class="s-link" href="{{ section.settings.button_link }}">
                {{- section.settings.button_label | escape -}}
                <svg class="s-link__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- else -%}
              <a class="{{ button_style }}" href="{{ section.settings.button_link }}">
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Editorial Saucha: imagen + texto. Tipografía, color, espacio y motion vienen de saucha-base.css */

  .saucha-editorial__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-space-8);
  }

  .saucha-editorial__copy-inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-space-4);
    align-items: center;
    text-align: center;
  }

  .saucha-editorial--align-mobile-left .saucha-editorial__copy-inner {
    align-items: flex-start;
    text-align: left;
  }

  .saucha-editorial__text {
    margin-top: var(--s-space-1);
  }

  .saucha-editorial--align-mobile-center .saucha-editorial__text {
    margin-inline: auto;
  }

  .saucha-editorial__divider {
    display: block;
    width: 1px;
    height: 40px;
    margin-block: var(--s-space-1);
    background: currentColor;
    opacity: 0.28;
  }

  .saucha-editorial__action {
    margin-top: var(--s-space-4);
  }

  .saucha-editorial--mobile-text_first .saucha-editorial__copy {
    order: -1;
  }

  @media screen and (min-width: 750px) {
    .saucha-editorial__grid {
      grid-template-columns: minmax(0, var(--se-image-share)) minmax(0, var(--se-text-share));
      gap: clamp(var(--s-space-10), 6vw, var(--s-space-24));
      align-items: var(--se-valign);
    }

    .saucha-editorial--image-right .saucha-editorial__grid {
      grid-template-columns: minmax(0, var(--se-text-share)) minmax(0, var(--se-image-share));
    }

    .saucha-editorial--image-right .saucha-editorial__media {
      order: 2;
    }

    .saucha-editorial--mobile-text_first .saucha-editorial__copy {
      order: 0;
    }

    .saucha-editorial__copy-inner,
    .saucha-editorial--align-mobile-left .saucha-editorial__copy-inner {
      align-items: center;
      text-align: center;
      max-width: 34rem;
      margin-inline: auto;
    }

    .saucha-editorial--align-left .saucha-editorial__copy-inner {
      align-items: flex-start;
      text-align: left;
      margin-inline: 0;
    }

    .saucha-editorial--align-center .saucha-editorial__text {
      margin-inline: auto;
    }

    .saucha-editorial--align-left .saucha-editorial__text {
      margin-inline: 0;
    }

    .saucha-editorial__divider {
      height: 56px;
      margin-block: var(--s-space-2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial Saucha",
  "tag": "div",
  "class": "saucha-editorial-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "info": "Se muestra en mayúsculas pequeñas."
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Título",
      "default": "Calidad que se siente",
      "info": "Cada salto de línea crea una línea animada."
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h1", "label": "Grande" },
        { "value": "h2", "label": "Medio" },
        { "value": "h3", "label": "Pequeño" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Una selección cuidada de prendas pensadas para acompañarte temporada tras temporada.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Línea vertical fina",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubrir"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [
        { "value": "button", "label": "Principal" },
        { "value": "button-secondary", "label": "Secundario" },
        { "value": "link", "label": "Enlace subrayado" }
      ],
      "default": "button-secondary"
    },
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen · escritorio"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen · móvil",
      "info": "Opcional. Si no la eliges, se usa la de escritorio."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción · escritorio",
      "options": [
        { "value": "4 / 5", "label": "Retrato 4:5" },
        { "value": "3 / 4", "label": "Retrato 3:4" },
        { "value": "2 / 3", "label": "Retrato alto 2:3" },
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 3", "label": "Horizontal 4:3" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Proporción · móvil",
      "options": [
        { "value": "4 / 5", "label": "Retrato 4:5" },
        { "value": "3 / 4", "label": "Retrato 3:4" },
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 3", "label": "Horizontal 4:3" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Encuadre horizontal · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Encuadre vertical · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_x_mobile",
      "label": "Encuadre horizontal · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y_mobile",
      "label": "Encuadre vertical · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Composición"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Imagen · escritorio",
      "options": [
        { "value": "left", "label": "A la izquierda" },
        { "value": "right", "label": "A la derecha" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Ancho de la imagen · escritorio",
      "min": 40,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Alineación vertical del texto",
      "options": [
        { "value": "start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto · escritorio",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Alineación del texto · móvil",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Orden · móvil",
      "options": [
        { "value": "image_first", "label": "Imagen primero" },
        { "value": "text_first", "label": "Texto primero" }
      ],
      "default": "image_first"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Marfil (principal)" },
        { "value": "cream", "label": "Crema (alterno)" },
        { "value": "blush", "label": "Blush nude" },
        { "value": "ink", "label": "Tinta" }
      ],
      "default": "surface"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Espacio superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md",
      "info": "Escala global en Configuración del tema › Saucha · Sistema. En móvil se reduce solo."
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Editorial Saucha",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
