<section
  id="ValoresSaucha-{{ section.id }}"
  class="
    s-section s-scheme-{{ section.settings.scheme }}
    s-pt-{{ section.settings.spacing_top }} s-pb-{{ section.settings.spacing_bottom }}
    saucha-valores
  "
>
  <div class="s-container">
    {% render 'saucha-heading', eyebrow: section.settings.eyebrow, title: section.settings.title, size: 'h3' %}

    <ul class="saucha-valores__lista" role="list">
      {%- for block in section.blocks -%}
        <li class="saucha-valores__item" data-s-reveal="up" style="--s-i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <span class="saucha-valores__icono" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 32 32"><path d="M3 8h16v14H3zM19 13h6l4 5v4h-10z"/><circle cx="9" cy="24" r="2.4"/><circle cx="24" cy="24" r="2.4"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 32 32"><path d="M8 12h14a6 6 0 0 1 0 12H12"/><path d="M12 7l-5 5 5 5"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 32 32"><path d="M16 26s-10-6.2-10-13a5.5 5.5 0 0 1 10-3.2A5.5 5.5 0 0 1 26 13c0 6.8-10 13-10 13z"/></svg>
              {%- when 'gift' -%}
                <svg viewBox="0 0 32 32"><path d="M5 13h22v5H5zM7 18h18v9H7zM16 13v14"/><path d="M16 13c-2-4-7-5-7-2s5 2 7 2zM16 13c2-4 7-5 7-2s-5 2-7 2z"/></svg>
              {%- when 'lock' -%}
                <svg viewBox="0 0 32 32"><rect x="7" y="14" width="18" height="12" rx="2"/><path d="M11 14v-3a5 5 0 0 1 10 0v3"/></svg>
              {%- when 'chat' -%}
                <svg viewBox="0 0 32 32"><path d="M6 8h20v13H14l-6 5v-5H6z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 32 32"><path d="M16 5l2.6 7.4L26 15l-7.4 2.6L16 25l-2.6-7.4L6 15l7.4-2.6z"/></svg>
            {%- endcase -%}
          </span>
          <span class="saucha-valores__copy">
            {%- if block.settings.title != blank -%}
              <span class="saucha-valores__titulo">{{ block.settings.title | escape }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="s-meta">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  /* Valores Saucha: fila de compromisos con iconos lineales finos */

  .saucha-valores .s-heading {
    margin-bottom: var(--s-space-10);
  }

  .saucha-valores__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-space-8) var(--s-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .saucha-valores__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-space-3);
    text-align: center;
  }

  .saucha-valores__icono svg {
    display: block;
    width: 30px;
    height: 30px;
    fill: none;
    stroke: var(--s-accent, currentColor);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .saucha-valores__copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-space-1);
    max-width: 18rem;
  }

  .saucha-valores__titulo {
    font-family: var(--s-font-serif);
    font-size: 1.1875rem;
    line-height: 1.2;
  }

  @media screen and (min-width: 990px) {
    .saucha-valores__lista {
      grid-template-columns: repeat(var(--sv-columns, 4), minmax(0, 1fr));
      gap: 0;
    }

    .saucha-valores__item {
      padding-inline: var(--s-space-6);
    }

    .saucha-valores__item + .saucha-valores__item {
      border-left: 1px solid var(--s-line);
    }

    .saucha-valores__titulo {
      font-size: 1.3125rem;
    }
  }

  .saucha-valores:has(.saucha-valores__item:nth-child(3):last-child) { --sv-columns: 3; }
  .saucha-valores:has(.saucha-valores__item:nth-child(2):last-child) { --sv-columns: 2; }
{% endstylesheet %}

{% schema %}
{
  "name": "Valores Saucha",
  "tag": "div",
  "class": "saucha-valores-section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Marfil (principal)" },
        { "value": "cream", "label": "Crema (alterno)" },
        { "value": "blush", "label": "Blush nude" }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Espacio superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "sm"
    }
  ],
  "blocks": [
    {
      "type": "valor",
      "name": "Valor",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "return", "label": "Devolución" },
            { "value": "heart", "label": "Corazón" },
            { "value": "gift", "label": "Regalo" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "chat", "label": "Atención" },
            { "value": "sparkle", "label": "Destello" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío gratis desde 50 €"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Preparamos cada pedido con cariño."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valores Saucha",
      "category": "t:categories.text",
      "blocks": [
        { "type": "valor", "settings": { "icon": "truck", "title": "Envío gratis desde 50 €", "text": "Preparamos cada pedido con cariño." } },
        { "type": "valor", "settings": { "icon": "return", "title": "Cambios sencillos", "text": "Si no es para ti, lo cambiamos." } },
        { "type": "valor", "settings": { "icon": "lock", "title": "Pago seguro", "text": "Compra protegida y cifrada." } },
        { "type": "valor", "settings": { "icon": "chat", "title": "Te asesoramos", "text": "Escríbenos, respondemos en persona." } }
      ]
    }
  ]
}
{% endschema %}
