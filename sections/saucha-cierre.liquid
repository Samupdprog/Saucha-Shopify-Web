{%- comment -%}
  Saucha · cierre de página: una frase y unos pocos enlaces de texto hacia la tienda.
  Discreto a propósito: sin botones grandes. Cada enlace es un bloque reordenable.
{%- endcomment -%}

<section
  class="s-section s-scheme-{{ section.settings.scheme }} s-pt-{{ section.settings.spacing_top }} s-pb-{{ section.settings.spacing_bottom }} s-cierre"
>
  <div class="s-container">
    <div class="s-cierre__inner">
      {%- if section.settings.text != blank -%}
        <div class="s-cierre__text" data-s-reveal="up">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="s-cierre__links" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank and block.settings.url != blank -%}
              <li data-s-reveal="fade" style="--s-i: {{ forloop.index }};" {{ block.shopify_attributes }}>
                <a class="s-cierre__link" href="{{ block.settings.url }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>
                  <span>{{ block.settings.label | escape }}</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8h9.5M9 4.5 12.5 8 9 11.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .s-cierre__inner {
    display: grid;
    gap: var(--s-space-10);
    padding-top: var(--s-space-12);
    border-top: 1px solid var(--s-color-line);
  }

  @media screen and (min-width: 990px) {
    .s-cierre__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: clamp(var(--s-space-12), 8vw, 136px);
      align-items: end;
    }
  }

  .s-cierre__text {
    font-family: var(--s-font-serif);
    font-weight: var(--s-font-serif-weight);
    font-size: clamp(1.75rem, 1.35rem + 1.7vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .s-cierre__text p {
    margin: 0;
  }

  .s-cierre__links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--s-color-line);
  }

  .s-cierre__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-space-4);
    padding-block: var(--s-space-4);
    border-bottom: 1px solid var(--s-color-line);
    color: var(--s-color-ink);
    font-family: var(--s-font-sans);
    font-size: var(--s-type-eyebrow);
    font-weight: 500;
    letter-spacing: var(--s-tracking-eyebrow);
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--s-dur-micro) var(--s-ease), padding var(--s-dur-image) var(--s-ease);
  }

  .s-cierre__link svg {
    flex: none;
    width: 16px;
    height: 16px;
    transition: transform var(--s-dur-image) var(--s-ease);
  }

  @media (hover: hover) {
    .s-cierre__link:hover {
      color: var(--s-color-cacao);
      padding-inline-start: 4px;
    }

    .s-cierre__link:hover svg {
      transform: translateX(4px);
    }
  }

  @media screen and (max-width: 749px) {
    .s-cierre__inner {
      gap: var(--s-space-8);
      padding-top: var(--s-space-10);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cierre Saucha",
  "tag": "div",
  "class": "saucha-cierre-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "blocks": [
    {
      "type": "enlace",
      "name": "Enlace",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Ver novedades" },
        { "type": "url", "id": "url", "label": "Enlace" },
        { "type": "checkbox", "id": "new_tab", "label": "Abrir en otra pestaña", "default": false }
      ]
    }
  ],
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Frase",
      "default": "<p>Te esperamos en la boutique o, estés donde estés, en la tienda online.</p>"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Base" },
        { "value": "cream", "label": "Crema" },
        { "value": "blush", "label": "Rosa" }
      ],
      "default": "surface"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Espacio superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "lg"
    }
  ],
  "presets": [
    {
      "name": "Cierre Saucha",
      "blocks": {
        "l1": { "type": "enlace", "settings": { "label": "Ver novedades" } },
        "l2": { "type": "enlace", "settings": { "label": "Todas las colecciones" } }
      },
      "block_order": ["l1", "l2"]
    }
  ]
}
{% endschema %}
