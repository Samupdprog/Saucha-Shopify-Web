{% liquid
  assign card_count = section.blocks.size
  if card_count > 4
    assign card_count = 4
  endif
%}

<section
  id="BentoSaucha-{{ section.id }}"
  class="
    s-section s-scheme-{{ section.settings.scheme }}
    s-pt-{{ section.settings.spacing_top }} s-pb-{{ section.settings.spacing_bottom }}
    saucha-bento saucha-bento--{{ section.settings.layout }} saucha-bento--count-{{ card_count }}
    saucha-bento--mobile-{{ section.settings.mobile_layout }}
  "
  style="--sb-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="s-container">
    {% render 'saucha-heading',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      text: section.settings.text,
      alignment: section.settings.heading_alignment
    %}

    <ul class="saucha-bento__grid" role="list">
      {%- for block in section.blocks limit: 4 -%}
        {%- liquid
          assign coleccion = block.settings.collection
          assign image = block.settings.image_desktop
          if image == blank and coleccion != blank
            assign image = coleccion.featured_image
          endif

          assign title = block.settings.title
          if title == blank and coleccion != blank
            assign title = coleccion.title
          endif

          assign url = block.settings.link
          if url == blank and coleccion != blank
            assign url = coleccion.url
          endif

          if forloop.first and section.settings.layout == 'bento'
            assign card_sizes = '(min-width: 750px) 50vw, 100vw'
          else
            assign card_sizes = '(min-width: 750px) 33vw, 50vw'
          endif
        -%}

        <li
          class="saucha-bento__item"
          data-s-reveal="up"
          style="--s-i: {{ forloop.index0 }};"
          {{ block.shopify_attributes }}
        >
          <a
            class="saucha-bento__card s-on-media"
            {% if url != blank %}href="{{ url }}"{% endif %}
            aria-label="{{ title | escape }}"
          >
            <div
              class="s-media s-media--hover saucha-bento__media"
              data-s-reveal="media"
              style="
                --s-fx: {{ block.settings.focus_x }}%;
                --s-fy: {{ block.settings.focus_y }}%;
                --s-fx-m: {{ block.settings.focus_x_mobile }}%;
                --s-fy-m: {{ block.settings.focus_y_mobile }}%;
                --s-overlay: var(--sb-overlay);
              "
            >
              {% render 'saucha-media',
                image: image,
                image_mobile: block.settings.image_mobile,
                sizes: card_sizes,
                sizes_mobile: '100vw',
                alt: title,
                placeholder: 'collection-apparel-1'
              %}
              <span class="s-media__overlay s-media__overlay--gradient" aria-hidden="true"></span>
            </div>

            <span class="saucha-bento__content">
              {%- if block.settings.eyebrow != blank -%}
                <span class="s-eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {%- endif -%}
              <span class="s-title s-title--h3 saucha-bento__title">{{ title | default: 'Colección' | escape }}</span>
              {%- if section.settings.link_label != blank -%}
                <span class="s-link saucha-bento__link">{{ section.settings.link_label | escape }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  /* Bento Saucha: colecciones con fotografía y texto sobre imagen */

  .saucha-bento__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .saucha-bento__item {
    min-width: 0;
  }

  .saucha-bento__card {
    position: relative;
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .saucha-bento__media {
    --s-media-ratio: 3 / 4;
    --s-media-ratio-m: 3 / 4;
  }

  .saucha-bento__content {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-space-2);
    padding: var(--s-space-4);
  }

  .saucha-bento__title {
    font-size: 1.375rem;
    line-height: 1.1;
  }

  .saucha-bento__link {
    margin-top: var(--s-space-1);
  }

  @media (hover: hover) {
    .saucha-bento__card:hover .saucha-bento__link {
      animation: s-link-redraw calc(var(--s-dur-image) * 1.6) var(--s-ease-inout) both;
    }
  }

  /* Móvil · primera tarjeta protagonista, resto en dos columnas */
  @media screen and (max-width: 749px) {
    .saucha-bento--mobile-stack .saucha-bento__item:first-child {
      grid-column: 1 / -1;
    }

    .saucha-bento--mobile-stack .saucha-bento__item:first-child .saucha-bento__media {
      --s-media-ratio-m: 4 / 5;
    }

    .saucha-bento--mobile-stack .saucha-bento__item:first-child .saucha-bento__title {
      font-size: var(--s-type-h3);
    }

    .saucha-bento--mobile-stack.saucha-bento--count-2 .saucha-bento__item:first-child,
    .saucha-bento--mobile-stack.saucha-bento--count-4 .saucha-bento__item:first-child {
      grid-column: auto;
    }

    .saucha-bento--mobile-stack.saucha-bento--count-2 .saucha-bento__item:first-child .saucha-bento__media,
    .saucha-bento--mobile-stack.saucha-bento--count-4 .saucha-bento__item:first-child .saucha-bento__media {
      --s-media-ratio-m: 3 / 4;
    }

    .saucha-bento--mobile-rail .saucha-bento__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      margin-inline: calc(var(--s-gutter) * -1);
      padding-inline: var(--s-gutter);
      scroll-padding-inline: var(--s-gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .saucha-bento--mobile-rail .saucha-bento__grid::-webkit-scrollbar {
      display: none;
    }

    .saucha-bento--mobile-rail .saucha-bento__item {
      scroll-snap-align: start;
    }

    .saucha-bento--mobile-rail .saucha-bento__media {
      --s-media-ratio-m: 4 / 5;
    }
  }

  @media screen and (min-width: 750px) {
    .saucha-bento__grid {
      grid-template-columns: repeat(var(--sb-columns, 2), minmax(0, 1fr));
      gap: var(--s-space-3);
    }

    .saucha-bento--count-3 { --sb-columns: 3; }
    .saucha-bento--count-4 { --sb-columns: 4; }
    .saucha-bento--count-1 { --sb-columns: 1; }

    .saucha-bento--count-1 .saucha-bento__media { --s-media-ratio: 16 / 7; }

    .saucha-bento__content {
      padding: var(--s-space-6);
      gap: var(--s-space-3);
    }

    .saucha-bento__title {
      font-size: var(--s-type-h3);
    }

    /* Bento: una tarjeta protagonista alta a la izquierda */
    .saucha-bento--bento.saucha-bento--count-3 .saucha-bento__grid,
    .saucha-bento--bento.saucha-bento--count-4 .saucha-bento__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      height: clamp(34rem, 52vw, 48rem);
    }

    .saucha-bento--bento .saucha-bento__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    .saucha-bento--bento.saucha-bento--count-3 .saucha-bento__item:not(:first-child) {
      grid-column: span 2;
    }

    .saucha-bento--bento.saucha-bento--count-4 .saucha-bento__item:nth-child(2) {
      grid-column: span 2;
    }

    .saucha-bento--bento.saucha-bento--count-3 .saucha-bento__media,
    .saucha-bento--bento.saucha-bento--count-4 .saucha-bento__media {
      --s-media-ratio: auto;
      --s-media-h: 100%;
    }

    .saucha-bento--bento .saucha-bento__item:first-child .saucha-bento__title {
      font-size: var(--s-type-h1);
    }

    .saucha-bento--bento .saucha-bento__item:first-child .saucha-bento__content {
      padding: var(--s-space-10);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bento Saucha",
  "tag": "div",
  "class": "saucha-bento-section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Título",
      "default": "Compra por colección"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace en cada tarjeta",
      "default": "Ver colección"
    },
    {
      "type": "header",
      "content": "Composición"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alineación del título",
      "options": [
        { "value": "center", "label": "Centrado" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposición · escritorio",
      "options": [
        { "value": "bento", "label": "Bento: una protagonista y el resto al lado" },
        { "value": "row", "label": "En fila, mismo tamaño" }
      ],
      "default": "bento",
      "info": "El bento se aplica con 3 o 4 tarjetas."
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Disposición · móvil",
      "options": [
        { "value": "stack", "label": "Primera grande, resto en dos columnas" },
        { "value": "rail", "label": "Carril deslizable" }
      ],
      "default": "stack"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Velo oscuro bajo el texto",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "%",
      "default": 26,
      "info": "Degradado desde abajo para leer el título sin apagar la foto."
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Marfil (principal)" },
        { "value": "cream", "label": "Crema (alterno)" },
        { "value": "blush", "label": "Blush nude" }
      ],
      "default": "surface"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Espacio superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    }
  ],
  "blocks": [
    {
      "type": "tarjeta",
      "name": "Tarjeta de colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección",
          "info": "Nombre, imagen y enlace se toman de la colección si no los personalizas."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Antetítulo",
          "info": "Opcional, p. ej. «Nueva temporada»."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título personalizado"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace personalizado"
        },
        {
          "type": "header",
          "content": "Imagen"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagen · escritorio"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen · móvil",
          "info": "Opcional. Si no la eliges, se usa la de escritorio."
        },
        {
          "type": "range",
          "id": "focus_x",
          "label": "Encuadre horizontal · escritorio",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focus_y",
          "label": "Encuadre vertical · escritorio",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focus_x_mobile",
          "label": "Encuadre horizontal · móvil",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "focus_y_mobile",
          "label": "Encuadre vertical · móvil",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento Saucha",
      "category": "t:categories.collection_list",
      "blocks": [
        { "type": "tarjeta" },
        { "type": "tarjeta" },
        { "type": "tarjeta" },
        { "type": "tarjeta" }
      ]
    }
  ]
}
{% endschema %}
