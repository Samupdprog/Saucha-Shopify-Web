{% liquid
  if section.settings.collection_list != blank
    assign section_collections = section.settings.collection_list
    assign max_items = section.settings.collection_list.count

    if max_items > 4
      assign max_items = 4
    endif
  else
    assign max_items = 4
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  id="BentoSaucha-{{ section.id }}"
  class="saucha-bento{% if section.settings.animation_enabled %} saucha-bento--animate{% endif %}"
  style="
    --saucha-bento-duration: {{ section.settings.animation_duration }}ms;
    --saucha-bento-stagger: {{ section.settings.animation_stagger }}ms;
    --saucha-bento-distance: {{ section.settings.animation_distance }}px;
  "
>
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      section-resource-list
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
    "
    data-testid="collection-list"
  >
    <div class="section-resource-list__content">
      {% content_for 'blocks' %}
    </div>

    {% if section_collections == null %}
      {% for i in (1..max_items) %}
        {% assign section_collections = section_collections | append: ', ' %}
      {% endfor %}
      {% assign section_collections = section_collections | split: ',' %}
    {% endif %}

    {% capture list_items %}
      {% for collection in section_collections limit: max_items %}
        {% liquid
          assign index = forloop.index

          assign image_desktop_key = 'card_' | append: index | append: '_image_desktop'
          assign image_mobile_key = 'card_' | append: index | append: '_image_mobile'

          assign x_desktop_key = 'card_' | append: index | append: '_x_desktop'
          assign y_desktop_key = 'card_' | append: index | append: '_y_desktop'
          assign zoom_desktop_key = 'card_' | append: index | append: '_zoom_desktop'

          assign x_mobile_key = 'card_' | append: index | append: '_x_mobile'
          assign y_mobile_key = 'card_' | append: index | append: '_y_mobile'
          assign zoom_mobile_key = 'card_' | append: index | append: '_zoom_mobile'

          assign saucha_image_desktop = section.settings[image_desktop_key]
          assign saucha_image_mobile = section.settings[image_mobile_key]

          assign saucha_position_x_desktop = section.settings[x_desktop_key]
          assign saucha_position_y_desktop = section.settings[y_desktop_key]
          assign saucha_zoom_desktop = section.settings[zoom_desktop_key]

          assign saucha_position_x_mobile = section.settings[x_mobile_key]
          assign saucha_position_y_mobile = section.settings[y_mobile_key]
          assign saucha_zoom_mobile = section.settings[zoom_mobile_key]
        %}

        <div class="resource-list__item">
          {% content_for 'block',
            type: '_collection-card-saucha',
            id: 'static-collection-card',
            closest.collection: collection,
            saucha_image_desktop: saucha_image_desktop,
            saucha_image_mobile: saucha_image_mobile,
            saucha_position_x_desktop: saucha_position_x_desktop,
            saucha_position_y_desktop: saucha_position_y_desktop,
            saucha_zoom_desktop: saucha_zoom_desktop,
            saucha_position_x_mobile: saucha_position_x_mobile,
            saucha_position_y_mobile: saucha_position_y_mobile,
            saucha_zoom_mobile: saucha_zoom_mobile
          %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endcapture %}

    {% liquid
      assign list_items_array = list_items | strip | split: '<!--@list/split-->'
    %}

    {% render 'resource-list-styles' %}

    <div
      class="resource-list resource-list--bento"
      style="
        --resource-list-column-gap-desktop: {{ section.settings.bento_gap }}px;
        --bento-gap: var(--resource-list-column-gap);
      "
      data-testid="collections-list-grid"
    >
      {% render 'bento-grid', items: list_items_array %}
    </div>
  </div>
</div>

{% stylesheet %}
  /* =========================================================
     SAUCHA · BENTO
     Animación suave de entrada
     ========================================================= */

  .saucha-bento--animate.is-animation-ready .bento-box__item {
    opacity: 0;
    transform: translateY(var(--saucha-bento-distance));

    transition:
      opacity var(--saucha-bento-duration)
        cubic-bezier(0.22, 1, 0.36, 1),
      transform var(--saucha-bento-duration)
        cubic-bezier(0.22, 1, 0.36, 1);

    will-change: opacity, transform;
  }

  .saucha-bento--animate.is-animation-ready
    .bento-box__item:nth-child(1) {
    transition-delay: 0ms;
  }

  .saucha-bento--animate.is-animation-ready
    .bento-box__item:nth-child(2) {
    transition-delay: var(--saucha-bento-stagger);
  }

  .saucha-bento--animate.is-animation-ready
    .bento-box__item:nth-child(3) {
    transition-delay:
      calc(
        var(--saucha-bento-stagger)
        + var(--saucha-bento-stagger)
      );
  }

  .saucha-bento--animate.is-animation-ready
    .bento-box__item:nth-child(4) {
    transition-delay:
      calc(
        var(--saucha-bento-stagger)
        + var(--saucha-bento-stagger)
        + var(--saucha-bento-stagger)
      );
  }

  .saucha-bento--animate.is-animation-ready.is-visible
    .bento-box__item {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .saucha-bento--animate.is-animation-ready .bento-box__item,
    .saucha-bento--animate.is-animation-ready.is-visible
      .bento-box__item {
      opacity: 1;
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById(
      'BentoSaucha-{{ section.id }}'
    );

    if (
      !section ||
      !section.classList.contains('saucha-bento--animate')
    ) {
      return;
    }

    const showSection = () => {
      section.classList.add('is-visible');
    };

    if (
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
    ) {
      section.classList.add('is-animation-ready');
      showSection();
      return;
    }

    section.classList.add('is-animation-ready');

    if (!('IntersectionObserver' in window)) {
      showSection();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          showSection();
          observer.unobserve(section);
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -5% 0px'
      }
    );

    observer.observe(section);
  })();
</script>

