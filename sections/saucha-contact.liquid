{%- comment -%}
  Saucha · página de contacto.

  1 · Fotografía de la boutique + información (dirección, «Cómo llegar», teléfono, correo, redes)
  2 · Horario (bloques «Día», reordenables; marca hoy y si está abierta ahora, hora de Canarias)
      + formulario nativo de Shopify (bloque «contact-form» de Horizon)
  3 · Mapa de Google, teñido con la paleta hasta que se usa

  Redes: Configuración del tema › Saucha › Redes sociales (snippets/saucha-social-links).
  Una línea de datos vacía no se muestra.
{%- endcomment -%}

{{ 'saucha-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign page_title = section.settings.title
  if page_title == blank and page != blank
    assign page_title = page.title
  endif

  assign intro = section.settings.text
  if section.settings.use_page_content and page.content != blank
    assign intro = page.content
  endif

  assign map_src = section.settings.map_url | strip
  unless map_src contains 'https://www.google.com/maps/embed'
    assign map_src = ''
  endunless

  assign has_photo = false
  if section.settings.image_desktop != blank or section.settings.image_mobile != blank
    assign has_photo = true
  endif

  assign phone_href = section.settings.phone | remove: ' ' | remove: '-' | remove: '.' | remove: '(' | remove: ')'
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  # Los bloques de tema llegan como «@theme»: aquí solo se admiten días (el formulario es estático y no cuenta)
  assign hour_count = section.blocks.size
-%}

<section
  class="s-section s-scheme-{{ section.settings.scheme }} s-pt-{{ section.settings.spacing_top }} s-pb-{{ section.settings.spacing_bottom }} s-contact"
  aria-labelledby="SauchaContact-{{ section.id }}"
>
  <div class="s-container">
    {%- comment -%} 1 · Boutique {%- endcomment -%}
    <div
      class="
        s-contact__lead
        s-contact__lead--image-{{ section.settings.image_side }}
        s-contact__lead--align-{{ section.settings.content_alignment }}
        {% unless has_photo or request.design_mode %}s-contact__lead--no-photo{% endunless %}
        {% if section.settings.mobile_image_first %}s-contact__lead--mobile-image-first{% endif %}
      "
    >
      {%- if has_photo or request.design_mode -%}
        <div
          class="s-media s-contact__photo"
          data-s-reveal="media"
          style="
            --s-media-h: {{ section.settings.height }}px;
            --s-media-h-m: {{ section.settings.height_mobile }}px;
            --s-fx: {{ section.settings.focus_x }}%; --s-fy: {{ section.settings.focus_y }}%;
            --s-fx-m: {{ section.settings.focus_x_mobile }}%; --s-fy-m: {{ section.settings.focus_y_mobile }}%;
          "
        >
          {% render 'saucha-media',
            image: section.settings.image_desktop,
            image_mobile: section.settings.image_mobile,
            sizes: '(min-width: 990px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: shop.name,
            placeholder: 'lifestyle-2'
          %}
          {%- if section.settings.overlay_opacity > 0 -%}
            <span
              class="s-contact__photo-overlay"
              style="background: {{ section.settings.overlay_color }}; opacity: {{ overlay_alpha }};"
              aria-hidden="true"
            ></span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="s-contact__info">
        <h1 class="s-contact__title" id="SauchaContact-{{ section.id }}" data-s-reveal="headline">{{ page_title | escape }}</h1>

        {%- if intro != blank -%}
          <div class="s-contact__text rte" data-s-reveal="up" style="--s-i: 1;">{{ intro }}</div>
        {%- endif -%}

        <div class="s-contact__facts" data-s-reveal="up" style="--s-i: 2;">
          {%- if section.settings.address != blank -%}
            <address class="s-contact__address">
              <span class="s-contact__store">{{ shop.name }}</span>
              {{ section.settings.address }}
            </address>
            {%- if section.settings.directions_url != blank -%}
              <a class="s-contact__directions" href="{{ section.settings.directions_url }}" target="_blank" rel="noopener">
                {{ section.settings.directions_label | default: 'Cómo llegar' | escape }}
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.phone != blank or section.settings.email != blank -%}
            <p class="s-contact__lines">
              {%- if section.settings.phone != blank -%}
                <a class="s-contact__line" href="tel:{{ phone_href }}">{{ section.settings.phone | escape }}</a>
              {%- endif -%}
              {%- if section.settings.email != blank -%}
                <a class="s-contact__line" href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
              {%- endif -%}
            </p>
          {%- endif -%}

          {% render 'saucha-social-links', class: 's-contact__social' %}
        </div>
      </div>
    </div>

    {%- comment -%} 2 · Horario + formulario {%- endcomment -%}
    <div class="s-contact__middle">
      {%- if hour_count > 0 -%}
        <div class="s-contact__hours" data-saucha-hours data-timezone="{{ section.settings.timezone | default: 'Atlantic/Canary' }}" data-s-reveal="up">
          <h2 class="s-contact__subtitle">{{ section.settings.hours_title | default: 'Horario' | escape }}</h2>
          <p class="s-contact__status" data-hours-status hidden></p>
          <dl class="s-contact__days">
            {% content_for 'blocks' %}
          </dl>
          {%- if section.settings.hours_note != blank -%}
            <div class="s-contact__note rte">{{ section.settings.hours_note }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="s-contact__form" data-s-reveal="up" style="--s-i: 1;">
        {%- if section.settings.form_title != blank -%}
          <h2 class="s-contact__subtitle">{{ section.settings.form_title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.form_text != blank -%}
          <div class="s-contact__form-text rte">{{ section.settings.form_text }}</div>
        {%- endif -%}
        {% content_for 'block', type: 'contact-form', id: 'contact-form' %}
      </div>
    </div>

    {%- comment -%} 3 · Mapa {%- endcomment -%}
    {%- if map_src != blank -%}
      <div
        class="s-contact__map"
        data-s-reveal="fade"
        style="--s-map-h: {{ section.settings.map_height }}px; --s-map-h-m: {{ section.settings.map_height_mobile }}px;"
      >
        <iframe
          src="{{ map_src }}"
          title="Mapa: {{ shop.name | escape }}{% if section.settings.address != blank %}, {{ section.settings.address | strip_html | strip | escape }}{% endif %}"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if hour_count > 0 -%}
  <script>
    /* Saucha · horario: marca hoy y dice si la boutique está abierta, con la hora local de la tienda.
       Entiende «10:00 – 20:00», «10:00-14:00 · 17:00-20:00» o «Cerrado». Si no entiende nada, no dice nada. */
    (() => {
      const run = () => {
        document.querySelectorAll('[data-saucha-hours]:not([data-ready])').forEach((root) => {
          root.dataset.ready = 'true';
          const timeZone = root.dataset.timezone || 'Atlantic/Canary';
          let parts;
          try {
            parts = new Intl.DateTimeFormat('en-GB', { timeZone, weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
          } catch (e) {
            return;
          }
          const get = (type) => parts.find((p) => p.type === type)?.value;
          const today = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(get('weekday')) + 1;
          const now = Number(get('hour')) * 60 + Number(get('minute'));

          const days = {};
          root.querySelectorAll('[data-day]').forEach((row) => {
            const ranges = [...(row.dataset.hours || '').matchAll(/(\d{1,2})[:.h](\d{2})\s*[–—-]\s*(\d{1,2})[:.h](\d{2})/g)].map((m) => [
              Number(m[1]) * 60 + Number(m[2]),
              Number(m[3]) * 60 + Number(m[4]),
            ]);
            days[row.dataset.day] = ranges;
            if (row.dataset.day === String(today)) row.classList.add('is-today');
          });
          if (!Object.values(days).some((r) => r.length)) return;

          const fmt = (m) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
          const names = ['', 'el lunes', 'el martes', 'el miércoles', 'el jueves', 'el viernes', 'el sábado', 'el domingo'];
          const status = root.querySelector('[data-hours-status]');
          const open = (days[today] || []).find(([a, b]) => now >= a && now < b);

          let text = '';
          if (open) {
            text = `Abierto ahora · hasta las ${fmt(open[1])}`;
            root.classList.add('is-open');
          } else {
            const later = (days[today] || []).find(([a]) => a > now);
            if (later) {
              text = `Cerrado ahora · abre hoy a las ${fmt(later[0])}`;
            } else {
              for (let i = 1; i <= 7; i++) {
                const d = ((today - 1 + i) % 7) + 1;
                if (days[d]?.length) {
                  text = `Cerrado ahora · abre ${i === 1 ? 'mañana' : names[d]} a las ${fmt(days[d][0][0])}`;
                  break;
                }
              }
            }
          }
          if (status && text) {
            status.textContent = text;
            status.hidden = false;
          }
        });
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
      else run();
      document.addEventListener('shopify:section:load', run);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Contacto Saucha",
  "tag": "div",
  "class": "saucha-contact-section",
  "blocks": [
    { "type": "contact-form" },
    { "type": "_saucha-dia" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Texto"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "info": "Vacío = título de la página.",
      "default": "Contacto"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Ven a vernos a la boutique o escríbenos: te ayudamos con tallas, disponibilidad y pedidos.</p>"
    },
    {
      "type": "checkbox",
      "id": "use_page_content",
      "label": "Usar el contenido de la página",
      "info": "Si la página tiene texto en Tienda online › Páginas, sustituye al texto de arriba.",
      "default": false
    },
    {
      "type": "header",
      "content": "Datos de la boutique",
      "info": "Una línea vacía no se muestra. Las redes se configuran en Configuración del tema › Saucha."
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Dirección"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Enlace «Cómo llegar»",
      "info": "Enlace de Google Maps a la boutique."
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Texto del enlace",
      "default": "Cómo llegar"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Teléfono"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Correo"
    },
    {
      "type": "header",
      "content": "Horario",
      "info": "Un bloque «Día» por fila; se reordenan arrastrando."
    },
    {
      "type": "text",
      "id": "hours_title",
      "label": "Título",
      "default": "Horario"
    },
    {
      "type": "richtext",
      "id": "hours_note",
      "label": "Nota bajo el horario",
      "info": "Opcional. Ej. cambios en festivos."
    },
    {
      "type": "text",
      "id": "timezone",
      "label": "Zona horaria de la boutique",
      "info": "Para «Abierto ahora». Canarias: Atlantic/Canary",
      "default": "Atlantic/Canary"
    },
    {
      "type": "header",
      "content": "Formulario"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Título",
      "default": "Escríbenos"
    },
    {
      "type": "richtext",
      "id": "form_text",
      "label": "Texto",
      "default": "<p>Respondemos por correo lo antes posible.</p>"
    },
    {
      "type": "header",
      "content": "Fotografía de la boutique"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen escritorio"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen móvil",
      "info": "Opcional. Si falta, se usa la de escritorio."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Lado de la imagen · escritorio",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineación vertical del texto",
      "options": [
        { "value": "start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "end", "label": "Abajo" }
      ],
      "default": "end"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_first",
      "label": "Imagen antes del texto en móvil",
      "default": false
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Posición horizontal · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Posición vertical · escritorio",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_x_mobile",
      "label": "Posición horizontal · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focus_y_mobile",
      "label": "Posición vertical · móvil",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "height",
      "label": "Altura · escritorio",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Altura · móvil",
      "min": 260,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color del velo",
      "default": "#211b18"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Intensidad del velo",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mapa"
    },
    {
      "type": "text",
      "id": "map_url",
      "label": "Mapa de Google (URL de inserción)",
      "info": "En Google Maps: Compartir › Insertar un mapa › copia solo el enlace de src=\"…\". Debe empezar por https://www.google.com/maps/embed"
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Altura · escritorio",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "map_height_mobile",
      "label": "Altura · móvil",
      "min": 240,
      "max": 520,
      "step": 20,
      "unit": "px",
      "default": 340
    },
    {
      "type": "header",
      "content": "Sección"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Base" },
        { "value": "cream", "label": "Crema" },
        { "value": "blush", "label": "Rosa" }
      ],
      "default": "surface"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Espacio superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "lg"
    }
  ],
  "presets": [
    {
      "name": "Contacto Saucha",
      "blocks": {
        "contact-form": { "type": "contact-form", "static": true },
        "d1": { "type": "_saucha-dia", "settings": { "day": "1", "hours": "10:00 – 20:00" } },
        "d2": { "type": "_saucha-dia", "settings": { "day": "2", "hours": "10:00 – 20:00" } },
        "d3": { "type": "_saucha-dia", "settings": { "day": "3", "hours": "10:00 – 20:00" } },
        "d4": { "type": "_saucha-dia", "settings": { "day": "4", "hours": "10:00 – 20:00" } },
        "d5": { "type": "_saucha-dia", "settings": { "day": "5", "hours": "10:00 – 20:00" } },
        "d6": { "type": "_saucha-dia", "settings": { "day": "6", "hours": "10:00 – 14:00" } },
        "d7": { "type": "_saucha-dia", "settings": { "day": "7", "hours": "Cerrado" } }
      },
      "block_order": ["d1", "d2", "d3", "d4", "d5", "d6", "d7"]
    }
  ]
}
{% endschema %}
