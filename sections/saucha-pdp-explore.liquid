{% comment %}
  Saucha · «Sigue explorando»: otras categorías para continuar la navegación desde la ficha.

  Se rellena solo, sin configurar nada, en este orden y sin repetir:
    1. las otras colecciones del producto (la primera ya aparece en «Más de [categoría]»)
    2. las colecciones elegidas en la sección
    3. el resto de colecciones de la tienda con productos
  Una, dos o tres tarjetas: la composición se adapta. En móvil, carril deslizable.
{% endcomment %}

{%- liquid
  assign max_cards = section.settings.max_cards
  assign picked = ','
  assign count = 0

  # La categoría principal del producto se excluye: ya tiene su propia sección de productos
  assign main_handle = ''
  if product != blank
    if collection != blank and collection.handle != 'all' and collection.handle != 'frontpage'
      assign main_handle = collection.handle
    else
      for product_collection in product.collections
        if product_collection.handle != 'all' and product_collection.handle != 'frontpage' and product_collection.products_count > 1
          assign main_handle = product_collection.handle
          break
        endif
      endfor
    endif
    assign picked = picked | append: main_handle | append: ','

    for product_collection in product.collections
      if count >= max_cards
        break
      endif
      assign token = ',' | append: product_collection.handle | append: ','
      if product_collection.handle == 'all' or product_collection.handle == 'frontpage' or product_collection.products_count == 0 or picked contains token
        continue
      endif
      assign picked = picked | append: product_collection.handle | append: ','
      assign count = count | plus: 1
    endfor
  endif

  for listed in section.settings.collection_list
    if count >= max_cards
      break
    endif
    assign token = ',' | append: listed.handle | append: ','
    if picked contains token or listed.products_count == 0
      continue
    endif
    assign picked = picked | append: listed.handle | append: ','
    assign count = count | plus: 1
  endfor

  if section.settings.fill_from_store
    for store_collection in collections
      if count >= max_cards
        break
      endif
      assign token = ',' | append: store_collection.handle | append: ','
      if store_collection.handle == 'all' or store_collection.handle == 'frontpage' or store_collection.products_count == 0 or picked contains token
        continue
      endif
      assign picked = picked | append: store_collection.handle | append: ','
      assign count = count | plus: 1
    endfor
  endif

  assign handles = picked | remove_first: ',' | split: ','
-%}

{%- if count > 0 or request.design_mode -%}
  <section
    class="s-section s-scheme-{{ section.settings.scheme }} s-pt-{{ section.settings.spacing_top }} s-pb-{{ section.settings.spacing_bottom }} s-pdp-explore s-pdp-explore--{{ count | at_most: 3 }}"
  >
    <div class="s-container">
      {% render 'saucha-heading',
        eyebrow: section.settings.eyebrow,
        title: section.settings.title,
        text: section.settings.text,
        alignment: section.settings.heading_alignment
      %}

      <ul class="s-pdp-explore__list" role="list">
        {%- assign shown = 0 -%}
        {%- for handle in handles -%}
          {%- if handle == blank or handle == main_handle -%}{%- continue -%}{%- endif -%}
          {%- assign item = collections[handle] -%}
          {%- if item == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign card_image = item.image | default: item.featured_image
            if card_image == blank
              assign card_image = item.products.first.featured_media.preview_image
            endif
          -%}
          <li class="s-pdp-explore__item" data-s-reveal="up" style="--s-i: {{ shown }};">
            <a class="s-pdp-explore__card" href="{{ item.url }}">
              <div class="s-media s-media--hover s-pdp-explore__media" data-s-reveal="media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1600
                    | image_tag:
                      widths: '420, 640, 860, 1100, 1400, 1600',
                      sizes: '(min-width: 990px) 40vw, 80vw',
                      loading: 'lazy',
                      class: 's-media__img',
                      alt: item.title
                  }}
                {%- else -%}
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                {%- endif -%}
                <span class="s-media__overlay s-media__overlay--gradient" style="--s-overlay: 0.32;"></span>
              </div>
              <span class="s-pdp-explore__info s-on-media">
                <span class="s-pdp-explore__title">{{ item.title | escape }}</span>
                <span class="s-pdp-explore__meta">
                  {{ item.products_count }} {{ item.products_count | pluralize: 'pieza', 'piezas' }}
                  <svg class="s-pdp-explore__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </span>
            </a>
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}

        {%- if shown == 0 and request.design_mode -%}
          {%- for i in (1..3) -%}
            <li class="s-pdp-explore__item">
              <div class="s-pdp-explore__card">
                <div class="s-media s-pdp-explore__media">{{ 'collection-apparel-' | append: i | placeholder_svg_tag }}</div>
                <span class="s-pdp-explore__info">
                  <span class="s-pdp-explore__title">Colección</span>
                </span>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /* Sigue explorando: tarjetas de categoría a toda altura, título serif sobre la foto */

  .s-pdp-explore__list {
    display: grid;
    gap: var(--s-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .s-pdp-explore__card {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .s-pdp-explore__media {
    --s-media-ratio: 4 / 5;
    --s-media-ratio-m: 4 / 5;
  }

  .s-pdp-explore__info {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--s-space-2);
    padding: var(--s-space-6);
  }

  .s-pdp-explore__title {
    font-family: var(--s-font-serif);
    font-weight: var(--s-font-serif-weight);
    font-size: var(--s-type-h3);
    line-height: 1.1;
    text-wrap: balance;
  }

  .s-pdp-explore__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-space-2);
    font-family: var(--s-font-sans);
    font-size: var(--s-type-eyebrow);
    font-weight: 500;
    letter-spacing: var(--s-tracking-eyebrow);
    text-transform: uppercase;
    color: var(--s-muted);
  }

  .s-pdp-explore__arrow {
    width: 14px;
    height: 14px;
    transition: transform var(--s-dur-micro) var(--s-ease);
  }

  @media (hover: hover) {
    .s-pdp-explore__card:hover .s-pdp-explore__arrow {
      transform: translateX(4px);
    }
  }

  .s-pdp-explore__card:focus-visible {
    outline: 2px solid var(--s-color-ink);
    outline-offset: 3px;
    border-radius: var(--s-radius-media);
  }

  /* Móvil: carril con asomo de la siguiente tarjeta */
  @media screen and (max-width: 749px) {
    .s-pdp-explore__list {
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      margin-inline: calc(var(--s-gutter) * -1);
      padding-inline: var(--s-gutter);
      scroll-padding-inline: var(--s-gutter);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .s-pdp-explore__list::-webkit-scrollbar {
      display: none;
    }

    .s-pdp-explore__item {
      scroll-snap-align: start;
    }

    .s-pdp-explore--1 .s-pdp-explore__list {
      grid-auto-columns: 100%;
    }

    .s-pdp-explore__info {
      padding: var(--s-space-5);
    }
  }

  @media screen and (min-width: 750px) {
    .s-pdp-explore__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-space-4);
    }

    .s-pdp-explore--2 .s-pdp-explore__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .s-pdp-explore--2 .s-pdp-explore__media {
      --s-media-ratio: 5 / 6;
    }

    /* Una sola categoría: banner horizontal */
    .s-pdp-explore--1 .s-pdp-explore__list {
      grid-template-columns: 1fr;
    }

    .s-pdp-explore--1 .s-pdp-explore__media {
      --s-media-ratio: 21 / 9;
    }

    .s-pdp-explore--1 .s-pdp-explore__title {
      font-size: var(--s-type-h1);
    }

    .s-pdp-explore__info {
      padding: var(--s-space-8);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sigue explorando",
  "tag": "div",
  "class": "s-pdp-explore-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Sigue explorando"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Título",
      "default": "Más ideas para ti"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alineación del título",
      "options": [
        { "value": "center", "label": "Centrado" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Categorías"
    },
    {
      "type": "paragraph",
      "content": "En la ficha se muestran primero las otras colecciones del producto; después, las elegidas aquí."
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Colecciones",
      "limit": 6
    },
    {
      "type": "checkbox",
      "id": "fill_from_store",
      "label": "Completar con otras colecciones de la tienda",
      "default": true
    },
    {
      "type": "range",
      "id": "max_cards",
      "label": "Número de categorías",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Fondo",
      "options": [
        { "value": "surface", "label": "Marfil (principal)" },
        { "value": "cream", "label": "Crema (alterno)" },
        { "value": "blush", "label": "Blush nude" }
      ],
      "default": "surface"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "Espacio superior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "options": [
        { "value": "none", "label": "Ninguno" },
        { "value": "xs", "label": "Mínimo" },
        { "value": "sm", "label": "Pequeño" },
        { "value": "md", "label": "Medio" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Sigue explorando",
      "category": "t:categories.collections"
    }
  ]
}
{% endschema %}
