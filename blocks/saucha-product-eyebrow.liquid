{%- doc -%}
  Saucha · antetítulo de la ficha: categoría del producto (enlazada) y etiquetas. Va encima del título.

  Categoría: la colección desde la que se llegó a la ficha o, si no, la primera
  colección del producto que no sea la portada ni «Todos».
  Etiquetas: «Rebaja −X %» sale sola del precio de comparación de la variante;
  el resto las pone el equipo en el metacampo «Etiquetas de producto» (snippets/saucha-product-labels).
{%- enddoc -%}

{%- liquid
  assign pdp_product = closest.product
  assign eyebrow_collection = blank

  if block.settings.show_collection
    if collection != blank and collection.handle != 'all' and collection.handle != 'frontpage'
      assign eyebrow_collection = collection
    else
      for product_collection in pdp_product.collections
        if product_collection.handle != 'all' and product_collection.handle != 'frontpage'
          assign eyebrow_collection = product_collection
          break
        endif
      endfor
    endif
  endif

  # Rebaja a nivel de producto: este bloque no se repinta al cambiar de variante
  # (el % exacto de cada variante lo muestra el precio, que sí se actualiza)
  assign on_sale = false
  if block.settings.show_sale and pdp_product.compare_at_price_max > pdp_product.price_min
    assign on_sale = true
  endif

  capture labels
    if block.settings.show_labels
      render 'saucha-product-labels', product: pdp_product
    endif
  endcapture
  assign labels = labels | strip
-%}

{%- if eyebrow_collection != blank or on_sale or labels != blank -%}
  <div class="s-pdp-eyebrow" {{ block.shopify_attributes }}>
    {%- if eyebrow_collection != blank -%}
      <a class="s-eyebrow s-pdp-eyebrow__link" href="{{ eyebrow_collection.url }}">{{ eyebrow_collection.title | escape }}</a>
    {%- endif -%}
    {%- if on_sale or labels != blank -%}
      <span class="s-pdp-eyebrow__labels">
        {%- if on_sale -%}
          <span class="s-label s-label--rebaja">{{ block.settings.sale_label | escape }}</span>
        {%- endif -%}
        {{- labels -}}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Antetítulo Saucha",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Categoría del producto y etiquetas sobre el título."
    },
    {
      "type": "checkbox",
      "id": "show_collection",
      "label": "Mostrar categoría",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Mostrar etiquetas del producto",
      "info": "Se eligen en cada producto, en el metacampo «Etiquetas de producto» (Nuevo, Edición limitada…).",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale",
      "label": "Mostrar etiqueta de rebaja",
      "info": "Aparece sola cuando alguna variante tiene precio de comparación.",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Texto de rebaja",
      "default": "Rebaja",
      "visible_if": "{{ block.settings.show_sale }}"
    }
  ],
  "presets": [
    {
      "name": "Antetítulo Saucha",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
