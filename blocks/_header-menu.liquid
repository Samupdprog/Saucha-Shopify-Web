    .saucha-mega-card__content {
      position: absolute;
      inset-inline: clamp(18px, 2vw, 30px);
      bottom: clamp(18px, 2vw, 28px);
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      color: inherit;
    }

    .saucha-mega-card__eyebrow {
      margin: 0;
      font-size: 11px;
      line-height: 1.2;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .saucha-mega-card__title {
      margin: 0;
      font-family: var(--font-heading--family);
      font-style: var(--font-heading--style);
      font-weight: var(--font-heading--weight);
      font-size: clamp(25px, 2.2vw, 40px);
      line-height: 0.98;
      letter-spacing: -0.025em;
      color: inherit;
    }

    .saucha-mega-card__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      margin-block-start: 8px;
      padding: 10px 18px;
      border: 1px solid currentColor;
      border-radius: max(4px, calc(var(--saucha-editorial-radius) * 0.35));
      font-size: 11px;
      line-height: 1;
      text-transform: uppercase;
      background: rgb(255 255 255 / 0.08);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      transition:
        background-color var(--animation-speed) var(--animation-easing),
        color var(--animation-speed) var(--animation-easing);
    }

    .saucha-mega-card:hover .saucha-mega-card__button,
    .saucha-mega-card:focus-visible .saucha-mega-card__button {
      color: #211b18;
      background: #fffdfa;
      border-color: #fffdfa;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1100px) {
    .saucha-mega-menu__grid--editorial {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 38%);
