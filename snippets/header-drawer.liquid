{%- doc -%}
  Renders a header drawer menu triggered by the top details element.

  @param {object} linklist - The linklist to render
  @param {string} [class] - Additional classes to add to the drawer
  @param {string} [data_header_drawer_type] - The type of header drawer to render
  @param {object} [block] - The block that can be used to provide settings
  @param {object} [section] - The section that can be used to provide settings

  @example
  {% render 'header-drawer', linklist: section.settings.menu, class: 'header-drawer--mobile' %}
{%- enddoc -%}

{% render 'summary-icon-styles' %}

{% liquid
  assign block_settings = block.settings
  assign max_featured_items = 4
  assign image_border_radius = block_settings.image_border_radius
  assign saucha_shop_position = block_settings.saucha_shop_position | default: 2

  assign promo_1_collection = block_settings.saucha_promo_1_collection
  assign promo_1_image = block_settings.saucha_promo_1_image
  assign promo_1_title = block_settings.saucha_promo_1_title
  assign promo_1_link = block_settings.saucha_promo_1_link
  if promo_1_image == blank and promo_1_collection != blank
    assign promo_1_image = promo_1_collection.featured_image
  endif
  if promo_1_title == blank and promo_1_collection != blank
    assign promo_1_title = promo_1_collection.title
  endif
  if promo_1_link == blank and promo_1_collection != blank
    assign promo_1_link = promo_1_collection.url
  endif

  assign promo_2_collection = block_settings.saucha_promo_2_collection
  assign promo_2_image = block_settings.saucha_promo_2_image
  assign promo_2_title = block_settings.saucha_promo_2_title
  assign promo_2_link = block_settings.saucha_promo_2_link
  if promo_2_image == blank and promo_2_collection != blank
    assign promo_2_image = promo_2_collection.featured_image
  endif
  if promo_2_title == blank and promo_2_collection != blank
    assign promo_2_title = promo_2_collection.title
  endif
  if promo_2_link == blank and promo_2_collection != blank
    assign promo_2_link = promo_2_collection.url
  endif

  assign saucha_mobile_has_promos = false
  if block_settings.saucha_editorial_cards
    if promo_1_image != blank or promo_2_image != blank
      assign saucha_mobile_has_promos = true
    endif
  endif

  if block_settings.menu_style == 'featured_collections'
    assign ratio = block_settings.featured_collections_aspect_ratio
  elsif block_settings.menu_style == 'featured_products'
    assign ratio = block_settings.featured_products_aspect_ratio
  endif

  ##
  # We only eager load heavy elements of the page when rendering this template
  # through the Section Rendering API.
  #
  # This keeps the initial render lightweight, minimizing the impact on TTFB.
  # The second render then refreshes the page with additional content.
  #
  # At the moment, we check if the Section Rendering API is being used by
  # checking if section.index is blank.
  assign eager_loading = false
  if section.index == blank
    assign eager_loading = true
  endif

  if block_settings.background_color != blank or block_settings.text_color != blank
    render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id
  endif
%}

<script
  src="{{ 'header-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<header-drawer
  class="header-drawer {{ class }}"
  style="
    --menu-image-border-radius: {{ image_border_radius }}px;
    --resource-card-corner-radius: {{ image_border_radius }}px;
    --saucha-drawer-inset: {{ block_settings.saucha_drawer_inset }}px;
    --saucha-drawer-double-inset: {{ block_settings.saucha_drawer_inset | times: 2 }}px;
    --saucha-drawer-radius: {{ block_settings.saucha_drawer_radius }}px;
    --saucha-drawer-animation: {{ block_settings.saucha_drawer_animation }}ms;
    --saucha-mobile-link-size: {{ block_settings.saucha_mobile_link_size }}px;
    --saucha-popular-ratio: {{ block_settings.saucha_mobile_popular_ratio }};
    --saucha-popular-width: {{ block_settings.saucha_mobile_popular_width }}vw;
    --saucha-popular-radius: {{ block_settings.saucha_mobile_popular_radius }}px;
    --saucha-editorial-radius: {{ block_settings.saucha_editorial_radius }}px;
    --saucha-editorial-ratio: {{ block_settings.saucha_editorial_ratio }};
    --saucha-editorial-text: {{ block_settings.saucha_editorial_text_color }};
    --saucha-editorial-scrim: {{ block_settings.saucha_editorial_scrim | divided_by: 100.0 }};
  "
>
  <details
    id="Details-menu-drawer-container"
    data-skip-node-update="true"
    class="menu-drawer-container"
    ref="details"
    scroll-lock
  >
    <summary
      class="header__icon header__icon--menu header__icon--summary"
      aria-label="{{ 'accessibility.menu' | t }}"
      on:click="/toggle"
    >
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--open">
        {{- 'icon-menu.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
        {{- 'icon-close-menu.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div
      ref="menuDrawer"
      class="
        menu-drawer
        {% if block_settings.background_color != blank or block_settings.text_color != blank %}
          color-custom-{{ block.id }}
        {% endif %}
      "
    >
      <button
        class="button close-button menu-drawer__close-button focus-inset"
        type="button"
        aria-label="{{ 'actions.close' | t }}"
        on:click="/close"
      >
        <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
          {{- 'icon-close-menu.svg' | inline_asset_content -}}
        </span>
      </button>
      <nav
        class="menu-drawer__navigation"
        style="
          {%- render 'menu-font-styles', settings: block_settings, menu_type: 'drawer' %}
          {%- render 'submenu-font-styles', settings: block_settings %}
        "
        aria-label="{{ 'accessibility.header_navigation_label' | t }}"
      >
        {% capture saucha_mobile_shop_item %}
          {% if block_settings.saucha_shop_enable %}
            <li
              class="menu-drawer__list-item saucha-shop-drawer__main-item"
              style="--menu-drawer-animation-index: {{ saucha_shop_position }};"
            >
              <details
                id="Details-menu-drawer-saucha-shop"
                class="menu-drawer__menu-container{% if block_settings.drawer_dividers %} menu-drawer__menu-container--divider{% endif %}"
              >
                <summary
                  id="HeaderDrawer-saucha-shop"
                  class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                  on:click="header-drawer/open/submenu"
                >
                  <span class="menu-drawer__menu-item-text wrap-text">{{ block_settings.saucha_shop_label | default: 'SHOP' | escape }}</span>
                  <span class="svg-wrapper icon-caret icon-caret--forward">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </summary>

                <div
                  id="link-saucha-shop"
                  class="menu-drawer__submenu has-submenu saucha-shop-drawer__panel"
                  tabindex="-1"
                >
                  <div class="menu-drawer__inner-submenu saucha-shop-drawer__inner">
                    <div class="saucha-shop-drawer__toolbar">
                      <button
                        class="button button-unstyled saucha-shop-drawer__back focus-inset"
                        type="button"
                        on:click="header-drawer/back"
                        aria-label="{{ 'actions.back_to_main_menu' | t }}"
                      >
                        <span class="svg-wrapper icon-caret icon-caret--backward">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                        <span>{{ block_settings.saucha_shop_label | default: 'SHOP' | escape }}</span>
                      </button>
                    </div>

                    <div class="saucha-shop-drawer__groups">
                      {% assign saucha_first_group_rendered = false %}
                      {% for column_index in (1..5) %}
                        {% liquid
                          assign parent_key = 'saucha_shop_col_' | append: column_index | append: '_parent'
                          assign title_key = 'saucha_shop_col_' | append: column_index | append: '_title'
                          assign collections_key = 'saucha_shop_col_' | append: column_index | append: '_collections'
                          assign column_parent = block_settings[parent_key]
                          assign column_title = block_settings[title_key]
                          assign column_collections = block_settings[collections_key]

                          if column_title == blank and column_parent != blank
                            assign column_title = column_parent.title
                          endif

                          assign open_this_group = false
                          if saucha_first_group_rendered == false and block_settings.saucha_mobile_first_group_open
                            assign open_this_group = true
                          endif
                        %}
                        {% if column_title != blank or column_collections != blank or column_parent != blank %}
                          <details class="saucha-shop-drawer__group"{% if open_this_group %} open{% endif %}>
                            <summary class="saucha-shop-drawer__group-summary">
                              <span>{{ column_title | default: 'Colecciones' | escape }}</span>
                              <span class="svg-wrapper saucha-shop-drawer__group-caret">
                                {{- 'icon-caret.svg' | inline_asset_content -}}
                              </span>
                            </summary>
                            {% if column_parent != blank or column_collections != blank %}
                              <div class="saucha-shop-drawer__group-content">
                                {% if column_parent != blank %}
                                  <a class="saucha-shop-drawer__parent-link" href="{{ column_parent.url }}">
                                    <span>{{ column_title | default: column_parent.title | escape }}</span>
                                    <span aria-hidden="true">→</span>
                                  </a>
                                {% endif %}
                                {% if column_collections != blank %}
                                  <ul class="saucha-shop-drawer__collection-list list-unstyled" role="list">
                                    {% for collection in column_collections %}
                                      <li>
                                        <a class="saucha-shop-drawer__collection-link" href="{{ collection.url }}">
                                          {{- collection.title | escape -}}
                                        </a>
                                      </li>
                                    {% endfor %}
                                  </ul>
                                {% endif %}
                              </div>
                            {% endif %}
                          </details>
                          {% assign saucha_first_group_rendered = true %}
                        {% endif %}
                      {% endfor %}
                    </div>

                    {% if saucha_mobile_has_promos %}
                      <div class="saucha-shop-drawer__promos" aria-label="Contenido destacado">
                        {% if promo_1_image != blank %}
                          {% liquid
                            assign promo_1_alt = promo_1_image.alt | default: promo_1_title
                          %}
                          {% if promo_1_link != blank %}
                            <a class="saucha-shop-drawer__promo-card" href="{{ promo_1_link }}">
                          {% else %}
                            <div class="saucha-shop-drawer__promo-card">
                          {% endif %}
                            {{ promo_1_image
                              | image_url: width: 900
                              | image_tag:
                                loading: 'lazy',
                                widths: '320, 480, 640, 900',
                                sizes: '78vw',
                                class: 'saucha-shop-drawer__promo-image',
                                alt: promo_1_alt
                            }}
                            <span class="saucha-shop-drawer__promo-scrim" aria-hidden="true"></span>
                            <span class="saucha-shop-drawer__promo-content">
                              {% if block_settings.saucha_promo_1_eyebrow != blank %}
                                <span class="saucha-shop-drawer__promo-eyebrow">{{ block_settings.saucha_promo_1_eyebrow | escape }}</span>
                              {% endif %}
                              {% if promo_1_title != blank %}
                                <span class="saucha-shop-drawer__promo-title">{{ promo_1_title | escape }}</span>
                              {% endif %}
                            </span>
                          {% if promo_1_link != blank %}
                            </a>
                          {% else %}
                            </div>
                          {% endif %}
                        {% endif %}

                        {% if promo_2_image != blank %}
                          {% liquid
                            assign promo_2_alt = promo_2_image.alt | default: promo_2_title
                          %}
                          {% if promo_2_link != blank %}
                            <a class="saucha-shop-drawer__promo-card" href="{{ promo_2_link }}">
                          {% else %}
                            <div class="saucha-shop-drawer__promo-card">
                          {% endif %}
                            {{ promo_2_image
                              | image_url: width: 900
                              | image_tag:
                                loading: 'lazy',
                                widths: '320, 480, 640, 900',
                                sizes: '78vw',
                                class: 'saucha-shop-drawer__promo-image',
                                alt: promo_2_alt
                            }}
                            <span class="saucha-shop-drawer__promo-scrim" aria-hidden="true"></span>
                            <span class="saucha-shop-drawer__promo-content">
                              {% if block_settings.saucha_promo_2_eyebrow != blank %}
                                <span class="saucha-shop-drawer__promo-eyebrow">{{ block_settings.saucha_promo_2_eyebrow | escape }}</span>
                              {% endif %}
                              {% if promo_2_title != blank %}
                                <span class="saucha-shop-drawer__promo-title">{{ promo_2_title | escape }}</span>
                              {% endif %}
                            </span>
                          {% if promo_2_link != blank %}
                            </a>
                          {% else %}
                            </div>
                          {% endif %}
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </details>
            </li>
          {% endif %}
        {% endcapture %}

        {% assign saucha_shop_inserted_mobile = false %}

        <ul
          class="menu-drawer__menu has-submenu"
          role="list"
        >
          {%- comment -%}
            Handle menus with fewer than 3 levels of links
          {%- endcomment -%}
          {% if linklist.levels < 3 %}
            {% assign first_accordion_open = false %}
            {% assign animation_index = 0 %}
            {%- for link in linklist.links -%}
              {% assign animation_index = animation_index | plus: 1 %}
              {% if block_settings.saucha_shop_enable and saucha_shop_inserted_mobile == false and forloop.index == saucha_shop_position %}
                {{ saucha_mobile_shop_item }}
                {% assign saucha_shop_inserted_mobile = true %}
              {% endif %}
              <li
                style="--menu-drawer-animation-index: {{ animation_index }};"
                class="{%- if block_settings.drawer_accordion -%}menu-drawer__list-item--deep{%- else -%}menu-drawer__list-item--flat{%- endif -%}{% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}"
              >
                {% if block_settings.saucha_mobile_submenu_style == 'panel' and link.links != blank %}
                  <details
                    id="Details-menu-drawer-menu-item-{{ forloop.index }}"
                    class="menu-drawer__menu-container{% if block_settings.drawer_dividers %} menu-drawer__menu-container--divider{% endif %}"
                  >
                    <summary
                      id="HeaderDrawer-{{ link.handle }}"
                      class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      on:click="header-drawer/open/submenu"
                    >
                      <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                      <span class="svg-wrapper icon-caret icon-caret--forward">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </summary>
                    <div
                      id="link-{{ link.handle | escape }}"
                      class="menu-drawer__submenu has-submenu"
                      tabindex="-1"
                      style="--menu-drawer-animation-index: {{ animation_index }};"
                    >
                      <div class="menu-drawer__inner-submenu">
                        <div class="menu-drawer__nav-buttons menu-drawer__nav-buttons--with-title">
                          <button
                            class="button menu-drawer__back-button focus-inset"
                            on:click="header-drawer/back"
                            aria-label="{{ 'actions.back_to_main_menu' | t }}"
                          >
                            <span class="svg-wrapper icon-caret icon-caret--backward">
                              {{- 'icon-caret.svg' | inline_asset_content -}}
                            </span>
                          </button>
                          <a
                            href="{{ link.url }}"
                            class="menu-drawer__title focus-inset"
                            {% if link.current %}aria-current="page"{% endif %}
                          >
                            <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                          </a>
                          <button
                            class="button button-unstyled close-button menu-drawer__close-button focus-inset"
                            type="button"
                            aria-label="{{ 'actions.close' | t }}"
                            on:click="header-drawer/close"
                          >
                            <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
                              {{- 'icon-close-menu.svg' | inline_asset_content -}}
                            </span>
                          </button>
                        </div>
                        <ul
                          class="menu-drawer__menu menu-drawer__menu--childlist"
                          role="list"
                          tabindex="-1"
                        >
                          {% for childlink in link.links %}
                            <li class="menu-drawer__list-item" style="--menu-drawer-animation-index: {{ forloop.index }};">
                              <a
                                id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                href="{{ childlink.url }}"
                                class="menu-drawer__menu-item menu-drawer__menu-item--parent{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                {% if childlink.current %}aria-current="page"{% endif %}
                              >
                                <span class="menu-drawer__menu-item-text wrap-text">{{ childlink.title | escape }}</span>
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  </details>
                {% elsif block_settings.drawer_accordion and link.links != blank %}
                  {%- comment -%}
                    Accordion for links with children, in menus with fewer than 3 levels of links
                  {%- endcomment -%}
                  {% liquid
                    assign should_open_first = false
                    if first_accordion_open == false and block_settings.drawer_accordion_expand_first
                      assign first_accordion_open = true
                      assign should_open_first = true
                    endif
                  %}
                  {% capture accordion_children %}
                    <details
                      id="Details-menu-drawer-{{ link.handle }}"
                    >
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                      >
                        <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                        <span class="svg-wrapper icon-plus">
                          {{- 'icon-plus.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      {% liquid
                        assign render_link_image = false
                        if block_settings.menu_style == 'collection_images'
                          assign catalog_links = link.links | where: 'type', 'catalog_link'
                          assign collection_list_links = link.links | where: 'type', 'collections_link'
                          assign collection_links = link.links | where: 'type', 'collection_link'
                          if catalog_links.size > 0 or collection_list_links.size > 0 or collection_links.size > 0
                            assign render_link_image = true
                          endif
                        endif
                      %}
                      <ul
                        class="menu-drawer__menu menu-drawer__menu--childlist menu-drawer__animated-element details-content{% if render_link_image %} menu-drawer__menu--grid{% endif %}"
                        role="list"
                        tabindex="-1"
                      >
                        {%- for childlink in link.links -%}
                          <li
                            class="menu-drawer__list-item"
                            style="--menu-drawer-animation-index: {{ forloop.index }};"
                          >
                            <a
                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                              href="{{ childlink.url }}"
                              class="menu-drawer__menu-item menu-drawer__menu-item--child{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                              {% if childlink.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {% if render_link_image %}
                                {% render 'link-featured-image',
                                  link: childlink,
                                  class: 'menu-drawer__link-image',
                                  sizes: 'auto, 400px'
                                %}
                              {% endif %}
                              <span class="menu-drawer__menu-item-text wrap-text">{{ childlink.title | escape }}</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  {% endcapture %}
                  {% render 'accordion-custom-component',
                    children: accordion_children,
                    open_by_default_on_mobile: should_open_first
                  %}
                {% elsif block_settings.drawer_accordion == false and link.links != blank %}
                  {%- comment -%}
                    Flat menus for links with children, in menus with fewer than 3 levels of links
                  {%- endcomment -%}
                  <a
                    id="HeaderDrawer-{{ link.handle }}"
                    href="{{ link.url }}"
                    class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                  </a>
                  {% liquid
                    assign render_link_image = false
                    if block_settings.menu_style == 'collection_images'
                      assign catalog_links = link.links | where: 'type', 'catalog_link'
                      assign collection_list_links = link.links | where: 'type', 'collections_link'
                      assign collection_links = link.links | where: 'type', 'collection_link'
                      if catalog_links.size > 0 or collection_list_links.size > 0 or collection_links.size > 0
                        assign render_link_image = true
                      endif
                    endif
                  %}
                  <ul
                    class="menu-drawer__menu menu-drawer__menu--childlist{% if render_link_image %} menu-drawer__menu--grid{% endif %}"
                    role="list"
                    tabindex="-1"
                  >
                    {%- for childlink in link.links -%}
                      <li
                        class="menu-drawer__list-item"
                        style="--menu-drawer-animation-index: {{ animation_index }};"
                      >
                        <a
                          href="{{ childlink.url }}"
                          class="menu-drawer__menu-item menu-drawer__menu-item--child menu-drawer__animated-element{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {% if render_link_image %}
                            {% render 'link-featured-image',
                              link: childlink,
                              class: 'menu-drawer__link-image',
                              sizes: 'auto, 400px'
                            %}
                          {% endif %}
                          <span class="menu-drawer__menu-item-text wrap-text">{{ childlink.title | escape }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {% else %}
                  {%- comment -%}
                    Simple links for links with no children (regardless of accordion setting), in menus with fewer than 3 levels of links
                  {%- endcomment -%}
                  <a
                    id="HeaderDrawer-{{ link.handle }}"
                    href="{{ link.url }}"
                    class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                  </a>
                {% endif %}
              </li>
            {%- endfor -%}
            {% if block_settings.saucha_shop_enable and saucha_shop_inserted_mobile == false %}
              {{ saucha_mobile_shop_item }}
              {% assign saucha_shop_inserted_mobile = true %}
            {% endif %}
          {% else %}
            {%- comment -%}
              Handle menus with 3 levels of links
            {%- endcomment -%}
            {% assign animation_index = 0 %}
            {%- for link in linklist.links -%}
              {% assign animation_index = animation_index | plus: 1 %}
              {% if block_settings.saucha_shop_enable and saucha_shop_inserted_mobile == false and forloop.index == saucha_shop_position %}
                {{ saucha_mobile_shop_item }}
                {% assign saucha_shop_inserted_mobile = true %}
              {% endif %}
              <li
                class="menu-drawer__list-item"
                style="--menu-drawer-animation-index: {{ animation_index }};"
              >
                {%- if link.links != blank -%}
                  {%- comment -%}
                    Regardless of the Accordion setting, in menus with 3 levels of links, we use a details element to handle the top level of the menu for links that have children.
                  {%- endcomment -%}
                  <details
                    id="Details-menu-drawer-menu-item-{{ forloop.index }}"
                    class="menu-drawer__menu-container{% if block_settings.drawer_dividers %} menu-drawer__menu-container--divider{% endif %}"
                  >
                    <summary
                      id="HeaderDrawer-{{ link.handle }}"
                      class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      on:click="header-drawer/open/submenu"
                    >
                      <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                      <span class="svg-wrapper icon-caret icon-caret--forward">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </summary>
                    <div
                      id="link-{{ link.handle | escape }}"
                      class="menu-drawer__submenu has-submenu"
                      tabindex="-1"
                      style="--menu-drawer-animation-index: {{ animation_index }};"
                    >
                      <div class="menu-drawer__inner-submenu">
                        <div class="menu-drawer__nav-buttons menu-drawer__nav-buttons--with-title">
                          <button
                            class="button menu-drawer__back-button focus-inset"
                            on:click="header-drawer/back"
                            aria-label="{{ 'actions.back_to_main_menu' | t }}"
                          >
                            <span class="svg-wrapper icon-caret icon-caret--backward">
                              {{- 'icon-caret.svg' | inline_asset_content -}}
                            </span>
                          </button>
                          <a
                            href="{{ link.url }}"
                            class="menu-drawer__title focus-inset"
                            {% if link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                          </a>
                          <button
                            class="button button-unstyled close-button menu-drawer__close-button focus-inset"
                            type="button"
                            aria-label="{{ 'actions.close' | t }}"
                            on:click="header-drawer/close"
                          >
                            <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
                              {{- 'icon-close-menu.svg' | inline_asset_content -}}
                            </span>
                          </button>
                        </div>
                        {% liquid
                          assign render_link_image = false
                          if block_settings.menu_style == 'collection_images'
                            assign catalog_links = link.links | where: 'type', 'catalog_link'
                            assign collection_list_links = link.links | where: 'type', 'collections_link'
                            assign collection_links = link.links | where: 'type', 'collection_link'
                            if catalog_links.size > 0 or collection_list_links.size > 0 or collection_links.size > 0
                              assign render_link_image = true
                            endif
                          endif
                        %}
                        <ul
                          class="menu-drawer__menu menu-drawer__menu--childlist{% if render_link_image and link.levels == 1 %} menu-drawer__menu--grid{% endif %}"
                          role="list"
                          tabindex="-1"
                        >
                          {% assign first_accordion_open = false -%}
                          {%- for childlink in link.links -%}
                            <li
                              class="
                                menu-drawer__list-item
                                {% if childlink.links != blank -%}
                                  {% if block_settings.drawer_accordion -%} menu-drawer__list-item--deep{% else -%} menu-drawer__list-item--flat{%- endif -%}
                                {%- endif -%}
                                {% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}
                              "
                            >
                              {%- if childlink.links == blank -%}
                                {%- comment -%}
                                  Simple links for links with no children (regardless of accordion setting), in menus with 3 levels of links
                                  This link is currently using --parent class style but --child would match the pattern on desktop
                                {%- endcomment -%}
                                <a
                                  id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                  href="{{ childlink.url }}"
                                  class="menu-drawer__menu-item menu-drawer__menu-item--parent{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                  {% if childlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {% if render_link_image and link.levels == 1 %}
                                    {% render 'link-featured-image',
                                      link: childlink,
                                      class: 'menu-drawer__link-image',
                                      sizes: 'auto, 400px'
                                    %}
                                  {% endif %}
                                  <span class="menu-drawer__menu-item-text wrap-text">
                                    {{- childlink.title | escape -}}
                                  </span>
                                </a>
                              {%- else -%}
                                {% liquid
                                  assign should_open_first_nested = false
                                  if first_accordion_open == false and block_settings.drawer_accordion and block_settings.drawer_accordion_expand_first
                                    assign first_accordion_open = true
                                    assign should_open_first_nested = true
                                  endif
                                %}
                                {% if block_settings.drawer_accordion %}
                                  {%- comment -%}
                                    Accordion for links with children, in menus with 3 levels of links
                                  {%- endcomment -%}
                                  {% capture accordion_children_nested %}
                                    <details
                                      id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}"
                                    >
                                      <summary
                                        id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                        class="menu-drawer__menu-item menu-drawer__menu-item--parent"
                                      >
                                        <span class="menu-drawer__menu-item-text wrap-text">
                                          {{- childlink.title | escape -}}
                                        </span>
                                        <span class="svg-wrapper icon-plus">
                                          {{- 'icon-plus.svg' | inline_asset_content -}}
                                        </span>
                                      </summary>
                                      {% liquid
                                        assign render_link_image = false
                                        if block_settings.menu_style == 'collection_images'
                                          assign catalog_links = childlink.links | where: 'type', 'catalog_link'
                                          assign collection_list_links = childlink.links | where: 'type', 'collections_link'
                                          assign collection_links = childlink.links | where: 'type', 'collection_link'
                                          if catalog_links.size > 0 or collection_list_links.size > 0 or collection_links.size > 0
                                            assign render_link_image = true
                                          endif
                                        endif
                                      %}
                                      <ul
                                        class="menu-drawer__menu menu-drawer__menu--grandchildlist details-content{% if render_link_image %} menu-drawer__menu--grid{% endif %}"
                                        role="list"
                                        tabindex="-1"
                                      >
                                        {%- for grandchildlink in childlink.links -%}
                                          <li
                                            class="menu-drawer__list-item"
                                            style="--menu-drawer-animation-index: {{ forloop.index }};"
                                          >
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item menu-drawer__menu-item--child{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}
                                                aria-current="page"
                                              {% endif %}
                                            >
                                              {% if render_link_image %}
                                                {% render 'link-featured-image',
                                                  link: grandchildlink,
                                                  class: 'menu-drawer__link-image',
                                                  sizes: 'auto, 400px'
                                                %}
                                              {% endif %}
                                              <span class="menu-drawer__menu-item-text wrap-text">
                                                {{- grandchildlink.title | escape -}}
                                              </span>
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </details>
                                  {% endcapture %}
                                  {% render 'accordion-custom-component',
                                    children: accordion_children_nested,
                                    open_by_default_on_mobile: should_open_first_nested
                                  %}
                                {% else %}
                                  {%- comment -%}
                                    Flat menus for links with children, in menus with 3 levels of links
                                  {%- endcomment -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item menu-drawer__menu-item--parent{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    <span class="menu-drawer__menu-item-text wrap-text">
                                      {{- childlink.title | escape -}}
                                    </span>
                                  </a>
                                  {% liquid
                                    assign render_link_image = false
                                    if block_settings.menu_style == 'collection_images'
                                      assign catalog_links = childlink.links | where: 'type', 'catalog_link'
                                      assign collection_list_links = childlink.links | where: 'type', 'collections_link'
                                      assign collection_links = childlink.links | where: 'type', 'collection_link'
                                      if catalog_links.size > 0 or collection_list_links.size > 0 or collection_links.size > 0
                                        assign render_link_image = true
                                      endif
                                    endif
                                  %}
                                  <ul
                                    class="menu-drawer__menu menu-drawer__menu--grandchildlist details-content{% if render_link_image %} menu-drawer__menu--grid{% endif %}"
                                    role="list"
                                    tabindex="-1"
                                  >
                                    {%- for grandchildlink in childlink.links -%}
                                      <li
                                        class="menu-drawer__list-item"
                                        style="--menu-drawer-animation-index: {{ forloop.index }};"
                                      >
                                        <a
                                          id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                          href="{{ grandchildlink.url }}"
                                          class="menu-drawer__menu-item menu-drawer__menu-item--child{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                          {% if grandchildlink.current %}
                                            aria-current="page"
                                          {% endif %}
                                        >
                                          {% if render_link_image %}
                                            {% render 'link-featured-image',
                                              link: grandchildlink,
                                              class: 'menu-drawer__link-image',
                                              sizes: 'auto, 400px'
                                            %}
                                          {% endif %}
                                          <span class="menu-drawer__menu-item-text wrap-text">
                                            {{- grandchildlink.title | escape -}}
                                          </span>
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                        {% liquid
                          if eager_loading
                            if block_settings.menu_style == 'featured_collections'
                              assign featured_collections = link.links | where: 'type', 'collection_link'
                            endif

                            if block_settings.menu_style == 'featured_products'
                              assign collection_linklist = link.links | where: 'type', 'collection_link' | first
                              assign featured_products_collection = collection_linklist.object
                            endif
                          else
                            assign featured_collections = null | sort
                            assign featured_products_collection = null | sort
                          endif
                        -%}

                        {% if featured_collections.size > 0 or featured_products_collection.products_count > 0 %}
                          <div
                            class="menu-drawer__featured-content menu-drawer__featured-content--childlist"
                            style="--menu-drawer-animation-index: {{ linklist.links.size | plus: 1 }};"
                          >
                            <ul class="menu-drawer__featured-content-list list-unstyled">
                              {% if featured_collections.size > 0 %}
                                {%- for collection in featured_collections limit: max_featured_items -%}
                                  <li class="menu-drawer__featured-content-list-item menu-drawer__featured-content-list-item--collection">
                                    {% render 'resource-card',
                                      resource: collection.object,
                                      resource_type: 'collection',
                                      style: 'overlay',
                                      image_aspect_ratio: ratio,
                                      image_sizes: 'auto, 400px'
                                    %}
                                  </li>
                                {%- endfor -%}
                              {% else %}
                                {% paginate featured_products_collection.products by max_featured_items %}
                                  {%- for product in featured_products_collection.products limit: max_featured_items -%}
                                    <li class="menu-drawer__featured-content-list-item menu-drawer__featured-content-list-item--product">
                                      {% render 'resource-card',
                                        resource: product,
                                        resource_type: 'product',
                                        image_aspect_ratio: ratio,
                                        image_sizes: 'auto, 400px',
                                        product_view_context: 'dialog'
                                      %}
                                    </li>
                                  {%- endfor -%}
                                {% endpaginate %}
                              {% endif %}
                            </ul>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </details>
                {%- else -%}
                  {%- comment -%}
                    Simple links for links with no children (regardless of accordion setting), in menus with 3 levels of links
                  {%- endcomment -%}
                  <a
                    id="HeaderDrawer-{{ link.handle }}"
                    href="{{ link.url }}"
                    class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {% if block_settings.saucha_shop_enable and saucha_shop_inserted_mobile == false %}
              {{ saucha_mobile_shop_item }}
              {% assign saucha_shop_inserted_mobile = true %}
            {% endif %}
          {% endif %}
        </ul>

        {% if block_settings.saucha_mobile_popular_enable and block_settings.saucha_mobile_popular_menu != blank %}
          <div class="saucha-drawer-popular menu-drawer__animated-element" style="--menu-drawer-animation-index: {{ linklist.links.size | plus: 1 }};">
            {% if block_settings.saucha_mobile_popular_title != blank %}
              <p class="saucha-drawer-popular__title">{{ block_settings.saucha_mobile_popular_title | escape }}</p>
            {% endif %}
            <ul class="saucha-drawer-popular__list list-unstyled" role="list">
              {% for popular_link in block_settings.saucha_mobile_popular_menu.links limit: block_settings.saucha_mobile_popular_limit %}
                {% liquid
                  assign popular_image = blank
                  if popular_link.type == 'collection_link' and popular_link.object.featured_image != blank
                    assign popular_image = popular_link.object.featured_image
                  endif
                  assign popular_alt = popular_image.alt | default: popular_link.title
                %}
                <li class="saucha-drawer-popular__item">
                  <a href="{{ popular_link.url }}" class="saucha-drawer-popular__card">
                    {% if popular_image != blank %}
                      {{ popular_image
                        | image_url: width: 720
                        | image_tag:
                          loading: 'lazy',
                          widths: '280, 420, 560, 720',
                          sizes: '78vw',
                          class: 'saucha-drawer-popular__image',
                          alt: popular_alt
                      }}
                    {% else %}
                      <span class="saucha-drawer-popular__placeholder" aria-hidden="true"></span>
                    {% endif %}
                    <span class="saucha-drawer-popular__label">{{ popular_link.title | escape }}</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </nav>
      {%- if shop.customer_accounts_enabled -%}
        <div
          class="saucha-drawer-footer menu-drawer__animated-element"
          style="--menu-drawer-animation-index: {{ linklist.links.size | plus: 1 }};"
        >
          <a class="saucha-drawer-footer__link" href="{{ routes.account_url }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8.5" r="3.6"/><path d="M4.8 20c1.2-3.6 4-5.4 7.2-5.4s6 1.8 7.2 5.4" stroke-linecap="round"/></svg>
            {%- if customer -%}Mi cuenta{%- else -%}Iniciar sesión{%- endif -%}
          </a>
        </div>
      {%- endif -%}
      <div
        class="menu-drawer__utility-links menu-drawer__animated-element"
        style="--menu-drawer-animation-index: {{ linklist.links.size }};"
      >
        {% liquid
          assign show_language = section.settings.show_language
          if localization.available_languages.size <= 1
            assign show_language = false
          endif

          assign show_country = section.settings.show_country
          if localization.available_countries.size <= 1
            assign show_country = false
          endif
        %}
        {% if data_header_drawer_type == 'mobile-drawer' and show_country or show_language %}
          {% liquid
            assign background_brightness = block_settings.background_color | color_brightness
            if background_brightness < 64
              assign flag_shadow_size = 4
            else
              assign flag_shadow_size = 2
            endif

            assign localization_font = '--menu-localization-font: var(--font-[localization_font]--family); ' | replace: '[localization_font]', section.settings.localization_font
            assign color_shadow = '--color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));'
            assign form_style = localization_font | append: color_shadow
          %}
          {% if show_language and show_country == false %}
            <div class="menu-drawer__localization color-custom-popover">
              {% render 'localization-form',
                show_country: show_country,
                show_language: show_language,
                localization_style: 'drawer',
                form_style: form_style,
                form_id: block.id
              %}
            </div>
          {% else %}
            <drawer-localization-component class="menu-drawer__localization">
              <details
                id="drawer-localization"
                class="drawer-localization"
                on:toggle="/toggle"
              >
                <summary
                  id="HeaderDrawer-localization"
                  class="drawer-localization__button h3 focus-inset"
                  aria-expanded="false"
                  on:click="header-drawer/open/submenu"
                  style="{{ form_style }}"
                >
                  <div class="drawer-localization__button--label h6">
                    {%- if show_country -%}
                      <div class="mobile-localization mobile-localization--country">
                        {%- if section.settings.country_selector_style == true -%}
                          <span
                            class="icon-flag"
                            style="
                              background-image: url({{- localization.country | image_url: width: 32 }});
                              --size-shadow: {{ flag_shadow_size }}px;
                              --color-shadow: rgb(var(--color-foreground-rgb) / var(--opacity-30-60));
                            "
                          ></span>
                        {%- endif -%}
                        <span class="currency-code">
                          {{- localization.country.currency.iso_code -}}
                        </span>
                      </div>
                    {%- endif -%}

                    {%- if show_country and show_language -%}
                      <span>/</span>
                    {%- endif -%}

                    {%- if show_language -%}
                      <div class="mobile-localization mobile-localization--country">
                        <span>
                          {{ localization.language.iso_code | upcase }}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>
                  <span class="svg-wrapper icon-caret icon-caret--forward">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </summary>

                <div
                  class="menu-drawer__submenu has-submenu color-custom-drawer"
                >
                  <div
                    class="menu-drawer__nav-buttons menu-drawer__nav-buttons--with-title"
                    ref="navButtons"
                  >
                    <button
                      class="button menu-drawer__back-button focus-inset"
                      on:click="header-drawer/back"
                      aria-label="{{ 'actions.back_to_main_menu' | t }}"
                    >
                      <span class="svg-wrapper icon-caret icon-caret--backward">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </button>
                    <span class="menu-drawer__title">
                      {{- 'content.localization_region_and_language' | t -}}
                    </span>
                    <button
                      class="button close-button menu-drawer__close-button focus-inset"
                      type="button"
                      aria-label="{{ 'actions.close' | t }}"
                      on:click="header-drawer/close"
                    >
                      <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
                        {{- 'icon-close-menu.svg' | inline_asset_content -}}
                      </span>
                    </button>
                  </div>

                  {% render 'localization-form',
                    show_country: show_country,
                    show_language: show_language,
                    localization_style: 'drawer',
                    form_style: form_style,
                    form_id: block.id
                  %}
                </div>
              </details>
            </drawer-localization-component>
          {% endif %}
        {%- endif -%}
      </div>

      {% liquid
        if block_settings.menu_style == 'featured_collections'
          assign top_level_featured_collections = linklist.links | where: 'type', 'collection_link'
        endif

        if eager_loading and block_settings.menu_style == 'featured_products'
          for link in linklist.links
            if link.type == 'collection_link'
              assign collection_linklist = link
              assign top_level_featured_products_collection = collection_linklist.object
              break
            elsif link.type == 'catalog_link' or link.type == 'collections_link'
              assign top_level_featured_products_collection = collections.all
              break
            endif
          endfor
        endif
      -%}
      {% if top_level_featured_collections.size > 0 or top_level_featured_products_collection.products_count > 0 %}
        <div
          class="menu-drawer__featured-content"
          style="--menu-drawer-animation-index: {{ linklist.links.size | plus: 1 }};"
        >
          <ul class="menu-drawer__featured-content-list menu-drawer__animated-element list-unstyled">
            {% if top_level_featured_collections.size > 0 %}
              {%- for collection in top_level_featured_collections limit: max_featured_items -%}
                <li class="menu-drawer__featured-content-list-item menu-drawer__featured-content-list-item--collection">
                  {% render 'resource-card',
                    resource: collection.object,
                    resource_type: 'collection',
                    style: 'overlay',
                    image_aspect_ratio: ratio,
                    image_sizes: 'auto, 400px'
                  %}
                </li>
              {%- endfor -%}
            {% elsif top_level_featured_products_collection.products_count > 0 %}
              {% paginate top_level_featured_products_collection.products by max_featured_items %}
                {%- for product in top_level_featured_products_collection.products limit: max_featured_items -%}
                  <li class="menu-drawer__featured-content-list-item menu-drawer__featured-content-list-item--product">
                    {% render 'resource-card',
                      resource: product,
                      resource_type: 'product',
                      image_aspect_ratio: ratio,
                      image_sizes: 'auto, 400px',
                      product_view_context: 'dialog'
                    %}
                  </li>
                {%- endfor -%}
              {% endpaginate %}
            {% endif %}
          </ul>
        </div>
      {% endif %}
    </div>
    <div
      class="menu-drawer__backdrop"
      on:click="header-drawer/close"
    ></div>
  </details>
</header-drawer>

{% stylesheet %}
  .icon-caret--forward svg {
    transform: rotate(-90deg);
  }

  .icon-caret--backward svg {
    transform: rotate(90deg);
  }

  .header__icon--menu {
    position: initial;
  }

  .menu-drawer-container .header__icon--summary {
    color: var(--color-foreground);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--padding-lg);
  }

  .header__icon--summary .header-drawer-icon {
    margin: auto;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .menu-drawer__featured-content {
    z-index: var(--layer-base);
    container-type: inline-size;
  }

  .menu-drawer__featured-content--childlist {
    z-index: var(--layer-flat);
  }

  .menu-drawer__featured-content-list {
    display: flex;
    gap: 1em;
    overflow-x: auto;
    padding-block-end: var(--padding-lg);
  }

  .menu-drawer__featured-content-list-item {
    flex: 0 0 auto;
  }

  .menu-drawer__featured-content-list-item--product {
    width: 35cqi;
  }

  .menu-drawer__featured-content-list-item--collection img.resource-card__image {
    width: 80cqi;
  }

  .menu-drawer__featured-content-list-item:first-child {
    margin-inline-start: var(--margin-xl);
  }

  .menu-drawer__featured-content-list-item:last-child {
    margin-inline-end: var(--margin-xl);
  }

  .menu-drawer__navigation {
    padding: 0;

    @media screen and (min-width: 750px) {
      margin-top: var(--drawer-header-desktop-top);
    }
  }

  details:not(.menu-open) .header__icon--menu .header-drawer-icon--close {
    display: none;
  }

  details.menu-open .header__icon--menu .header-drawer-icon--close {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  details.menu-open .header__icon--menu .header-drawer-icon--open {
    display: none;

    @media screen and (min-width: 750px) {
      display: flex;
    }
  }

  .menu-drawer {
    position: fixed;
    transform: translateX(-100%);
    visibility: hidden;
    height: var(--drawer-height);
    width: var(--drawer-width);
    max-width: var(--drawer-max-width);
    z-index: var(--layer-menu-drawer);
    left: 0;
    top: 0;

    /* Left-anchored drawer spans the full physical viewport (viewport-fit=cover); keep its
       content clear of the status bar, left-side notch, and home indicator. Subtract the
       designed menu gutter so link text aligns with the page / hamburger, not inset twice. */
    padding: var(--safe-area-inset-top) 0 var(--safe-area-inset-bottom)
      max(0px, calc(var(--safe-area-inset-left) - var(--drawer-padding)));
    background-color: var(--color-background);
    overflow: auto;
    display: flex;
    border-right: var(--style-border-drawer);
    flex-direction: column;

    @media screen and (min-width: 750px) {
      width: 25rem;
    }
  }

  /* When opening a submenu we don't want the first-level menu to be scrollable, so we reset the overflow  */
  .menu-drawer.menu-drawer--has-submenu-opened {
    overflow: initial;
  }

  .menu-drawer__backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    backdrop-filter: brightness(0.75);
    z-index: var(--layer-overlay);
    opacity: 0;
    transition: opacity var(--drawer-animation-speed) ease;

    .menu-open & {
      opacity: 1;
    }
  }

  .menu-drawer,
  details[open] > .menu-drawer__submenu {
    transition: transform var(--drawer-animation-speed) ease, visibility var(--drawer-animation-speed) ease,
      opacity var(--drawer-animation-speed) ease;
  }

  .menu-open > .menu-drawer,
  .menu-open > .menu-drawer__submenu:not(.menu-drawer__menu--childlist) {
    transform: translateX(0);
    visibility: visible;
    opacity: 1;
    display: flex;
    flex-direction: column;
  }

  .menu-drawer__inner-container {
    position: relative;
    height: 100%;
  }

  .menu-drawer__navigation-container {
    display: grid;
    grid-template-rows: 1fr auto;
    align-content: space-between;
    overflow-y: auto;
    height: 100%;
  }

  .menu-drawer__inner-submenu {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;

    @media screen and (min-width: 750px) {
      margin-top: var(--drawer-header-desktop-top);
    }
  }

  .menu-drawer__nav-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Submenu header with a centered, clickable title flanked by the back and
     close controls. */
  .menu-drawer__nav-buttons--with-title {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }

  .menu-drawer__title {
    justify-self: center;
    min-width: 0;
    padding: var(--padding-md) var(--padding-sm);
    color: var(--color-foreground);
    text-align: center;
    text-decoration: none;
    line-height: 1.2;
  }

  .menu-drawer__menu {
    --menu-drawer-inline-padding: calc(var(--padding-sm) + 7px);

    list-style: none;
    padding-inline: var(--drawer-padding);
    margin-inline: 0;
    margin-block-start: 0;
  }

  .menu-drawer__menu--grid {
    display: grid;
    width: 100%;
    grid-template-columns: 1fr 1fr;
    gap: var(--padding-sm);
    padding-inline-end: var(--menu-drawer-inline-padding);
    padding-block-start: var(--padding-xs);
  }

  .menu-drawer__menu--childlist:not(.menu-drawer__menu--grid) {
    flex-grow: 1;
  }

  .menu-drawer__menu.has-submenu,
  .menu-drawer__menu--childlist:not(:has(.menu-drawer__animated-element)) {
    margin-block-end: var(--margin-xs);

    @media screen and (min-width: 750px) {
      margin-block-end: 2.5rem;
    }
  }

  .menu-drawer__list-item--divider {
    border-block-end: 1px solid var(--color-border);
  }

  .menu-drawer__list-item--deep:not(.menu-drawer__list-item--divider) .menu-drawer__menu {
    margin-block-start: -0.3rem;
  }

  .menu-drawer__list-item--flat.menu-drawer__list-item--divider .menu-drawer__menu {
    margin-block-start: -0.4rem;
  }

  .menu-drawer__menu-container--divider {
    border-block-end: 1px solid var(--color-border);
  }

  .menu-drawer__menu > .menu-drawer__list-item {
    display: flex;
    min-height: calc(2 * var(--padding-lg) + var(--icon-size-xs));
  }

  .menu-drawer__list-item--deep .menu-drawer__list-item,
  .menu-drawer__list-item--flat .menu-drawer__list-item {
    min-height: auto;
  }

  .menu-drawer__menu .menu-drawer__list-item--flat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-block-end: var(--margin-md);
  }

  .menu-drawer__menu--childlist .menu-drawer__list-item--flat {
    margin-block-end: var(--margin-sm);

    @media screen and (min-width: 750px) {
      margin-block-end: var(--margin-lg);
    }
  }

  .menu-drawer__menu--childlist .menu-drawer__list-item--flat.menu-drawer__list-item--divider {
    margin-block-end: 0;
  }

  .menu-drawer__list-item--flat .menu-drawer__menu--childlist {
    width: 100%;
    padding-inline: 0;
  }

  .menu-drawer-container[open] .menu-drawer__animated-element {
    animation: menu-drawer-nav-open var(--drawer-animation-speed) ease-in-out;
    animation-delay: calc(var(--drawer-animation-speed) + (var(--menu-drawer-animation-index) - 1) * 0.1s);
    animation-fill-mode: backwards;
  }

  .menu-drawer__menu accordion-custom .details-content--no-animation {
    animation: none;
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    transition: none;
  }

  .menu-drawer__menu details,
  .menu-drawer__menu-item,
  .menu-drawer__menu accordion-custom {
    width: 100%;
  }

  .menu-drawer__list-item--divider .menu-drawer__menu-item:not(.menu-drawer__menu-item--child) {
    min-height: calc(2 * var(--padding-lg) + var(--icon-size-xs));
  }

  .menu-drawer__menu-item--mainlist {
    min-height: calc(2 * var(--padding-lg) + var(--icon-size-xs));
    font-family: var(--menu-top-level-font-family);
    font-style: var(--menu-top-level-font-style);
    font-weight: var(--menu-top-level-font-weight);
    font-size: var(--menu-top-level-font-size);
    line-height: var(--menu-top-level-font-line-height);
    text-transform: var(--menu-top-level-font-case);
    color: var(--menu-top-level-font-color);
    justify-content: space-between;

    &:hover {
      color: var(--menu-top-level-font-color);
    }
  }

  .menu-drawer__menu-item--parent {
    font-family: var(--menu-parent-font-family);
    font-style: var(--menu-parent-font-style);
    font-weight: var(--menu-parent-font-weight);
    font-size: var(--menu-parent-font-size);
    line-height: var(--menu-parent-font-line-height);
    text-transform: var(--menu-parent-font-case);
    color: var(--menu-parent-font-color);

    &:hover {
      color: var(--menu-parent-font-color);
    }
  }

  .menu-drawer__menu-item--child {
    font-family: var(--menu-child-font-family);
    font-style: var(--menu-child-font-style);
    font-weight: var(--menu-child-font-weight);
    font-size: var(--menu-child-font-size);
    line-height: var(--menu-child-font-line-height);
    text-transform: var(--menu-child-font-case);
    color: var(--menu-child-font-color);

    &:hover {
      color: var(--menu-child-font-color);
    }
  }

  .menu-drawer__menu--childlist summary.menu-drawer__menu-item {
    display: flex;
    width: 100%;
    padding-inline-end: 0;
  }

  .menu-drawer__list-item--deep .menu-drawer__menu,
  .menu-drawer__menu--grandchildlist {
    padding-inline: 0;
  }

  .menu-drawer__list-item--deep .menu-drawer__menu {
    padding-block-end: 0.5rem;
  }

  .menu-drawer__list-item--deep.menu-drawer__list-item--divider .menu-drawer__menu {
    padding-block-end: 0.3rem;
  }

  .menu-drawer__list-item--flat.menu-drawer__list-item--divider .menu-drawer__menu--grandchildlist {
    padding-block-end: 0.5rem;
  }

  .menu-drawer__menu-item {
    display: flex;
    padding: var(--padding-2xs) 0;
    position: relative;
    text-decoration: none;
    justify-content: space-between;
    align-items: center;
  }

  .menu-drawer__menu-item:has(> .menu-drawer__link-image) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    row-gap: var(--padding-3xs);
    padding: 0;
  }

  .menu-drawer__link-image {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Fix alignment for collection image mode links without images in drawer */

  /* Target menu items in grids that have images */
  .menu-drawer__menu--grid:has(.menu-drawer__link-image) .menu-drawer__menu-item:not(:has(> .menu-drawer__link-image)) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    row-gap: var(--padding-3xs);
    padding: 0;
  }

  .menu-drawer__menu--grid:has(.menu-drawer__link-image)
    .menu-drawer__menu-item:not(:has(> .menu-drawer__link-image))::before {
    content: '';
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-foreground-muted);
    opacity: 0.1;
    border-radius: var(--menu-image-border-radius);
  }

  .menu-drawer__close-button {
    position: relative;
    right: auto;
    top: auto;
    width: fit-content;
    height: fit-content;
    color: inherit;
    padding: var(--padding-lg);
  }

  .menu-drawer__back-button {
    display: flex;
    width: 100%;
    padding: var(--padding-md) var(--padding-xl);
    border: none;
    align-items: center;
    color: var(--color-foreground);
    background-color: transparent;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    overflow-x: hidden;
    line-height: 1.2;
    box-shadow: none;
  }

  /* Match the menu links' focus style: a rectangular outline in the current color.
     These buttons sit flush against the drawer edges, so inset the outline to keep
     it from being clipped. */
  .menu-drawer__close-button.menu-drawer__close-button,
  .menu-drawer__back-button.menu-drawer__back-button {
    border-radius: 0;
    outline-offset: calc(var(--padding-2xs) * -1);
  }

  /* Safari < 16.4 draws the close focus ring via a pseudo-element; keep it
     rectangular there too. */
  .menu-drawer__close-button:focus-visible::after {
    border-radius: 0;
  }

  .menu-drawer__nav-buttons--with-title .menu-drawer__back-button {
    width: fit-content;
    padding: var(--padding-lg);
    justify-self: start;
  }

  .menu-drawer__nav-buttons--with-title .menu-drawer__close-button {
    justify-self: end;
  }

  .menu-drawer__menu-item-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /** Styles when the country selector is hidden */
  .menu-drawer .language-selector:not(.menu-drawer__submenu *) {
    width: fit-content;
    padding-inline-start: 0;

    .localization-form__select {
      text-align: left;
    }
  }

  .menu-drawer__menu-item > .svg-wrapper {
    width: fit-content;
    height: fit-content;
    margin: 0;
    padding-block: var(--padding-lg);
    padding-inline-start: var(--padding-xl);
    flex-shrink: 0;
  }

  .menu-drawer__list-item--divider .menu-drawer__menu-item > .svg-wrapper {
    padding-block: var(--padding-md);
  }

  .menu-drawer svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .menu-drawer__submenu {
    position: absolute;
    width: 100%;
    top: 0;
    height: 100dvh;
    left: 0;

    /* Submenus are absolutely positioned so they bypass the drawer's safe-area padding;
       apply the same insets directly */
    padding: var(--safe-area-inset-top) 0 var(--safe-area-inset-bottom)
      max(0px, calc(var(--safe-area-inset-left) - var(--drawer-padding)));
    background-color: var(--color-background);
    z-index: var(--layer-flat);
    transform: translateX(-5%);
    visibility: hidden;
    overflow-y: auto;
    opacity: 0;
  }

  .menu-drawer__back-button > .svg-wrapper {
    margin-right: var(--padding-md);
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .menu-drawer__utility-links {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin-block: auto var(--padding-sm);
    margin-inline-start: var(--padding-xl);
  }

  .menu-drawer__account {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    text-decoration: none;
    height: 44px;
    font-size: 1.4rem;
    color: rgb(var(--color-foreground));
  }

  .menu-drawer__account svg {
    height: var(--icon-size-sm);
    width: var(--icon-size-sm);
  }

  .menu-drawer__account shop-user-avatar {
    --shop-avatar-size: 2.4rem;

    margin-right: 0.55rem;
    margin-left: -0.45rem;
  }

  .menu-drawer__link-image,
  .menu-drawer__featured-product-image,
  .menu-drawer__featured-collection-image,
  .menu-drawer__featured-collection-link::before {
    border-radius: var(--menu-image-border-radius);
  }

  @keyframes menu-drawer-nav-open {
    0% {
      visibility: hidden;
      opacity: 0;
      transform: translateX(-0.5rem);
    }

    100% {
      visibility: visible;
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes menu-drawer-subnav-open {
    0% {
      visibility: visible;
      opacity: 1;
      transform: translateX(0);
    }

    100% {
      visibility: hidden;
      opacity: 0;
      transform: translateX(-1rem);
    }
  }

  /* Drawer Localization Styles */
  .drawer-localization__button .icon-flag {
    width: var(--menu-localization-font-size, var(--icon-size-sm));
    height: var(--menu-localization-font-size, var(--icon-size-sm));
    clip-path: circle(50%); /* stylelint-disable-line */
    background-position: center;
    background-size: cover;
    margin-inline-end: 4px;
    position: relative;
  }

  .drawer-localization__button .icon-flag::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 var(--size-shadow) var(--color-shadow);
    border-radius: 50%;
  }

  .drawer-localization .country-filter {
    padding-block: 8px;
  }

  .drawer-localization .drawer-localization__button {
    display: flex;
    padding: 0;
    position: relative;
    text-decoration: none;
    height: 44px;

    &:hover {
      color: var(--color-foreground);
    }
  }

  .drawer-localization .drawer-localization__button .icon-caret {
    width: fit-content;
    height: fit-content;
    margin: 0;
    padding: var(--padding-xl) var(--padding-xl) var(--padding-xl) var(--padding-xs);
  }

  .menu-drawer__localization:not(drawer-localization-component) .language-selector {
    font-family: var(--menu-localization-font);
    font-size: var(--menu-localization-font-size);
  }

  .menu-drawer__localization .language-selector.h5 {
    padding-inline-start: 0;
  }

  .drawer-localization {
    display: contents;
    color: var(--color-foreground);
  }

  .drawer-localization localization-form-component {
    position: relative;
    height: 100%;
  }

  .drawer-localization .mobile-localization,
  .drawer-localization .drawer-localization__button--label {
    display: flex;
    gap: var(--gap-xs);
    margin-block: 0;
    align-items: center;
  }

  .drawer-localization__button--label.h6 {
    font-family: var(--menu-localization-font);
  }

  .drawer-localization img {
    width: var(--icon-size-sm);
  }

  .drawer-localization .localization-button__icon,
  .drawer-localization .localization-button__icon svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .drawer-localization summary.is-disabled {
    pointer-events: none;
  }

  .drawer-localization .localization-wrapper {
    width: 100%;
  }

  .drawer-localization .localization-form {
    display: flex;
    flex-direction: column;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .drawer-localization .localization-form > * {
    padding-inline: var(--padding-xl);
  }

  .drawer-localization .language-selector .svg-wrapper.icon-caret {
    transform: translateY(-50%) rotate(0deg);
    right: 20px;
  }

  .drawer-localization .language-selector .svg-wrapper.icon-caret svg {
    transform: none;
  }


  /* =========================================================
     SAUCHA — Drawer móvil editorial
     ========================================================= */
  @media screen and (max-width: 749px) {
    .header-drawer .menu-drawer {
      --drawer-animation-speed: var(--saucha-drawer-animation);
      left: var(--saucha-drawer-inset);
      top: var(--saucha-drawer-inset);
      width: calc(100vw - var(--saucha-drawer-double-inset));
      max-width: none;
      height: calc(100dvh - var(--saucha-drawer-double-inset));
      border: 0;
      border-radius: var(--saucha-drawer-radius);
      box-shadow: var(--s-shadow-drawer, 0 0 40px rgb(33 27 24 / 0.08));
      overflow: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }

    /* Mismo velo que el drawer de filtros: tinta cálida, sin filtros de brillo */
    .header-drawer .menu-drawer__backdrop {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgb(33 27 24 / 0.32);
    }

    /* Entrada escalonada de los enlaces con el easing de Saucha */
    .header-drawer .menu-drawer-container[open] .menu-drawer__animated-element {
      animation-duration: var(--s-dur-enter, 620ms);
      animation-timing-function: var(--s-ease, ease-out);
      animation-delay: calc(140ms + var(--menu-drawer-animation-index, 1) * var(--s-stagger, 70ms));
    }

    .header-drawer .menu-drawer,
    .header-drawer details[open] > .menu-drawer__submenu {
      transition:
        transform var(--saucha-drawer-animation) cubic-bezier(0.16, 1, 0.3, 1),
        visibility var(--saucha-drawer-animation) cubic-bezier(0.16, 1, 0.3, 1),
        opacity var(--saucha-drawer-animation) cubic-bezier(0.16, 1, 0.3, 1);
    }

    .header-drawer .menu-drawer > .menu-drawer__close-button {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: calc(var(--layer-flat) + 2);
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      padding: 0;
      border-radius: 50%;
      transition: background-color var(--s-dur-micro, 200ms) var(--s-ease, ease);
    }

    .header-drawer .menu-drawer > .menu-drawer__close-button:hover {
      background-color: rgb(var(--color-foreground-rgb) / 0.05);
    }

    .header-drawer .menu-drawer > .menu-drawer__close-button svg {
      width: 18px;
      height: 18px;
    }

    .header-drawer .menu-drawer__navigation {
      padding: 64px 0 24px;
    }

    .header-drawer .menu-drawer__menu.has-submenu {
      padding-inline: clamp(22px, 8vw, 38px);
      margin-block-end: 0;
    }

    /* Todos los enlaces principales (--flat, --deep y el panel Tienda) comparten ritmo y hairline */
    .header-drawer .menu-drawer__menu.has-submenu > li {
      min-height: 0;
      margin: 0;
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    }

    .header-drawer .menu-drawer__menu.has-submenu > li:last-child {
      border-block-end: 0;
    }

    .header-drawer .menu-drawer__menu-item--mainlist {
      width: 100%;
      min-height: 0;
      padding: 16px 0;
      font-size: var(--saucha-mobile-link-size);
      line-height: 1.15;
      letter-spacing: 0;
    }

    .header-drawer .menu-drawer__menu-item--active .menu-drawer__menu-item-text,
    .header-drawer .menu-drawer__menu-item[aria-current='page'] .menu-drawer__menu-item-text {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 6px;
    }

    .saucha-drawer-footer {
      margin: auto clamp(22px, 8vw, 38px) 0;
      padding-block: 18px max(18px, var(--safe-area-inset-bottom, 0px));
      border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    }

    .saucha-drawer-footer__link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      color: var(--color-foreground);
      font-family: var(--font-body--family);
      font-size: var(--s-type-button, 12px);
      font-weight: 500;
      letter-spacing: 0.08em;
      text-decoration: none;
    }

    .saucha-drawer-footer__link svg {
      width: 20px;
      height: 20px;
    }

    .header-drawer .menu-drawer__menu-item--mainlist > .svg-wrapper {
      padding: 0 2px 0 18px;
    }

    .header-drawer .menu-drawer__menu-item--mainlist .icon-caret svg {
      width: 10px;
      height: 10px;
    }

    .header-drawer .menu-drawer__submenu {
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border-radius: inherit;
      overflow: auto;
    }

    .header-drawer .menu-drawer__inner-submenu {
      min-height: 100%;
      height: auto;
    }

    .header-drawer .menu-drawer__nav-buttons--with-title {
      position: sticky;
      top: 0;
      z-index: calc(var(--layer-flat) + 1);
      min-height: 62px;
      background: var(--color-background);
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.10);
    }

    .header-drawer .menu-drawer__title {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.035em;
    }

    .header-drawer .menu-drawer__menu--childlist {
      padding-inline: clamp(22px, 8vw, 38px);
      padding-block: 14px 32px;
    }

    .header-drawer .menu-drawer__menu--childlist > .menu-drawer__list-item {
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.10);
    }

    .header-drawer .menu-drawer__menu-item--parent,
    .header-drawer .menu-drawer__menu-item--child {
      padding-block: 16px;
      font-size: 16px;
      line-height: 1.25;
    }

    .saucha-drawer-popular {
      margin-block-start: 34px;
    }

    .saucha-drawer-popular__title {
      margin: 0;
      padding-inline: clamp(22px, 8vw, 38px);
      font-size: 13px;
      line-height: 1.2;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .saucha-drawer-popular__list {
      display: flex;
      gap: 14px;
      margin: 18px 0 0;
      padding: 0 clamp(22px, 8vw, 38px) 12px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .saucha-drawer-popular__list::-webkit-scrollbar {
      display: none;
    }

    .saucha-drawer-popular__item {
      flex: 0 0 min(var(--saucha-popular-width), 330px);
      scroll-snap-align: start;
    }

    .saucha-drawer-popular__card {
      position: relative;
      display: block;
      aspect-ratio: var(--saucha-popular-ratio);
      overflow: hidden;
      border-radius: var(--saucha-popular-radius);
      color: #ffffff;
      text-decoration: none;
      background: rgb(var(--color-foreground-rgb) / 0.06);
      isolation: isolate;
    }

    .saucha-drawer-popular__card::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(to top, rgb(0 0 0 / 0.38), transparent 58%);
      pointer-events: none;
    }

    .saucha-drawer-popular__image,
    .saucha-drawer-popular__placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .saucha-drawer-popular__placeholder {
      background: rgb(var(--color-foreground-rgb) / 0.08);
    }

    .saucha-drawer-popular__label {
      position: absolute;
      left: 16px;
      right: 16px;
      bottom: 14px;
      z-index: 2;
      font-size: 14px;
      line-height: 1.15;
      color: inherit;
    }

    .header-drawer .menu-drawer__utility-links {
      margin-block-start: 8px;
      margin-inline: clamp(22px, 8vw, 38px);
      padding-block-end: 20px;
    }
  }


  /* =========================================================
     SAUCHA — Panel SHOP independiente en móvil
     ========================================================= */
  @media screen and (max-width: 749px) {
    .saucha-shop-drawer__main-item > details > summary {
      cursor: pointer;
    }

    .saucha-shop-drawer__panel {
      background: var(--color-background);
    }

    .saucha-shop-drawer__inner {
      padding: 0 clamp(28px, 8vw, 38px) 44px;
    }

    .saucha-shop-drawer__toolbar {
      display: flex;
      align-items: center;
      min-height: 108px;
      padding-top: 66px;
    }

    .saucha-shop-drawer__back {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      width: auto;
      min-height: 36px;
      padding: 8px 14px 8px 11px;
      border: 0;
      border-radius: 999px;
      background: rgb(var(--color-foreground-rgb) / 0.07);
      color: var(--color-foreground);
      font-size: 13px;
      line-height: 1;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }

    .saucha-shop-drawer__back .svg-wrapper {
      width: 12px;
      height: 12px;
      margin: 0;
    }

    .saucha-shop-drawer__groups {
      display: flex;
      flex-direction: column;
    }

    .saucha-shop-drawer__group {
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    }

    .saucha-shop-drawer__group:first-child {
      border-block-start: 0;
    }

    .saucha-shop-drawer__group-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      min-height: 72px;
      padding: 18px 0;
      cursor: pointer;
      list-style: none;
      font-size: clamp(18px, 5vw, 21px);
      line-height: 1.1;
      letter-spacing: -0.025em;
      text-transform: uppercase;
      color: var(--color-foreground);
    }

    .saucha-shop-drawer__group-summary::-webkit-details-marker {
      display: none;
    }

    .saucha-shop-drawer__group-caret {
      width: 12px;
      height: 12px;
      flex: 0 0 auto;
      transition: transform var(--saucha-drawer-animation) cubic-bezier(0.16, 1, 0.3, 1);
    }

    .saucha-shop-drawer__group[open] .saucha-shop-drawer__group-caret {
      transform: rotate(180deg);
    }

    .saucha-shop-drawer__collection-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 14px 0 24px;
    }

    .saucha-shop-drawer__collection-link {
      display: block;
      padding: 10px 0;
      color: rgb(var(--color-foreground-rgb) / 0.58);
      font-size: clamp(16px, 4.4vw, 19px);
      line-height: 1.25;
      text-decoration: none;
      transition: color var(--animation-speed) var(--animation-easing);
    }

    .saucha-shop-drawer__collection-link:active,
    .saucha-shop-drawer__collection-link:focus-visible {
      color: var(--color-foreground);
    }

    .saucha-shop-drawer__group-content {
      padding-bottom: 24px;
    }

    .saucha-shop-drawer__parent-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      width: fit-content;
      margin-top: 8px;
      color: var(--color-foreground);
      font-size: 14px;
      line-height: 1.2;
      text-decoration: none;
      text-transform: uppercase;
      opacity: 0.82;
      transition:
        opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
        transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .saucha-shop-drawer__parent-link:active,
    .saucha-shop-drawer__parent-link:focus-visible {
      opacity: 1;
      transform: translateX(2px);
    }

    .saucha-shop-drawer__group-content .saucha-shop-drawer__collection-list {
      padding-bottom: 0;
    }

    .saucha-shop-drawer__promos {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: min(78vw, 330px);
      gap: 14px;
      margin-top: 34px;
      margin-inline: calc(-1 * clamp(28px, 8vw, 38px));
      padding-inline: clamp(28px, 8vw, 38px);
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
    }

    .saucha-shop-drawer__promos::-webkit-scrollbar {
      display: none;
    }

    .saucha-shop-drawer__promo-card {
      position: relative;
      display: block;
      aspect-ratio: var(--saucha-editorial-ratio);
      overflow: hidden;
      border-radius: var(--saucha-editorial-radius);
      color: var(--saucha-editorial-text);
      text-decoration: none;
      isolation: isolate;
      scroll-snap-align: start;
      background: rgb(var(--color-foreground-rgb) / 0.06);
    }

    .saucha-shop-drawer__promo-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .saucha-shop-drawer__promo-scrim {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(
        to top,
        rgb(0 0 0 / calc(var(--saucha-editorial-scrim) * 1.25)) 0%,
        rgb(0 0 0 / calc(var(--saucha-editorial-scrim) * 0.5)) 42%,
        transparent 72%
      );
    }

    .saucha-shop-drawer__promo-content {
      position: absolute;
      z-index: 2;
      inset-inline: 18px;
      bottom: 18px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      color: inherit;
    }

    .saucha-shop-drawer__promo-eyebrow {
      font-size: 10px;
      line-height: 1.2;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .saucha-shop-drawer__promo-title {
      font-family: var(--font-heading--family);
      font-style: var(--font-heading--style);
      font-weight: var(--font-heading--weight);
      font-size: clamp(24px, 8vw, 34px);
      line-height: 0.98;
      letter-spacing: -0.025em;
      color: inherit;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-drawer {
      --saucha-drawer-animation: 0.01ms;
    }
  }

{% endstylesheet %}
