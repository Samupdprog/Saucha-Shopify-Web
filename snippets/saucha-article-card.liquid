{% doc %}
  Tarjeta de artículo de Saucha: imagen, fecha y tema, título, entradilla.
  Se usa en la página del blog, en «Seguir leyendo» y donde haga falta listar artículos.

  @param {article} article - El artículo
  @param {string} [variant] - 'default' | 'feature' (portada: más grande y con enlace «Leer»)
  @param {string} [ratio] - Proporción de la imagen, p. ej. '4 / 5'. Por defecto '4 / 5'
  @param {boolean} [show_excerpt] - Mostrar entradilla. Por defecto true
  @param {boolean} [show_tag] - Mostrar el primer tema. Por defecto true
  @param {boolean} [show_author] - Mostrar autor. Por defecto false
  @param {string} [sizes] - Atributo sizes de la imagen
  @param {string} [loading] - 'lazy' (defecto) o 'eager'
  @param {number} [index] - Posición, para escalonar la animación
  @param {string} [heading_tag] - 'h2' | 'h3'. Por defecto 'h3'

  @example
  {% render 'saucha-article-card', article: article, ratio: '4 / 5', index: forloop.index0 %}
{% enddoc %}

{%- liquid
  assign card_variant = variant | default: 'default'
  assign card_ratio = ratio | default: '4 / 5'
  assign card_sizes = sizes | default: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  assign card_loading = loading | default: 'lazy'
  assign card_heading = heading_tag | default: 'h3'
  assign card_index = index | default: 0

  assign card_show_excerpt = true
  if show_excerpt == false
    assign card_show_excerpt = false
  endif

  assign card_show_tag = true
  if show_tag == false
    assign card_show_tag = false
  endif

  if article.excerpt != blank
    assign excerpt = article.excerpt | strip_html | truncatewords: 32
  else
    assign excerpt = article.content | strip_html | truncatewords: 26
  endif
-%}

<article
  class="s-post s-post--{{ card_variant }}"
  data-s-reveal="up"
  style="--s-i: {{ card_index | modulo: 3 }};"
>
  <a class="s-post__media-link" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
    <div class="s-media s-post__media" style="--s-media-ratio: {{ card_ratio }}; --s-media-ratio-m: {{ card_ratio }};">
      {%- if article.image -%}
        {%- assign focal = article.image.presentation.focal_point | default: '50% 50%' | prepend: 'object-position: ' -%}
        {{
          article.image
          | image_url: width: 1800
          | image_tag:
            class: 's-media__img',
            widths: '400, 600, 800, 1000, 1200, 1500, 1800',
            sizes: card_sizes,
            loading: card_loading,
            alt: article.image.alt,
            style: focal
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </a>

  <div class="s-post__body">
    <p class="s-post__meta">
      {{- article.published_at | time_tag: format: 'date' -}}
      {%- if card_show_tag and article.tags.size > 0 -%}
        <span class="s-post__dot" aria-hidden="true"></span>
        <span>{{ article.tags.first }}</span>
      {%- endif -%}
      {%- if show_author and article.author != blank -%}
        <span class="s-post__dot" aria-hidden="true"></span>
        <span>{{ article.author }}</span>
      {%- endif -%}
    </p>

    <{{ card_heading }} class="s-post__title">
      <a href="{{ article.url }}">{{ article.title | escape }}</a>
    </{{ card_heading }}>

    {%- if card_show_excerpt and excerpt != blank -%}
      <p class="s-post__excerpt">{{ excerpt }}</p>
    {%- endif -%}

    {%- if card_variant == 'feature' -%}
      <a class="s-link s-post__more" href="{{ article.url }}" aria-label="Leer «{{ article.title | escape }}»">Leer artículo</a>
    {%- endif -%}
  </div>
</article>
