{%- doc -%}
  Saucha · migas de pan de la ficha: Inicio / Categoría / Producto, con datos estructurados
  BreadcrumbList para Google.

  Categoría: la colección desde la que se llegó o, si no, la primera colección del producto
  que no sea la portada ni «Todos» (misma regla que el antetítulo).

  @param {product} product - Producto

  @example
  {% render 'saucha-breadcrumbs', product: product %}
{%- enddoc -%}

{%- liquid
  assign crumb_collection = blank
  if collection != blank and collection.handle != 'all' and collection.handle != 'frontpage'
    assign crumb_collection = collection
  else
    for product_collection in product.collections
      if product_collection.handle != 'all' and product_collection.handle != 'frontpage'
        assign crumb_collection = product_collection
        break
      endif
    endfor
  endif
-%}

<nav class="s-breadcrumbs" aria-label="Migas de pan">
  <ol class="s-breadcrumbs__list">
    <li class="s-breadcrumbs__item"><a href="{{ routes.root_url }}">Inicio</a></li>
    {%- if crumb_collection != blank -%}
      <li class="s-breadcrumbs__item"><a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a></li>
    {%- endif -%}
    <li class="s-breadcrumbs__item" aria-current="page"><span>{{ product.title | escape }}</span></li>
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ shop.url | append: routes.root_url | json }} }
      {%- if crumb_collection != blank -%}
        , { "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ shop.url | append: crumb_collection.url | json }} }
      {%- endif -%}
      , { "@type": "ListItem", "position": {% if crumb_collection != blank %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
    ]
  }
</script>
