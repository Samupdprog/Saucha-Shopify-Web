{% doc %}
  Imagen responsive de Saucha: una imagen para escritorio y otra (opcional) para móvil,
  dentro de un <picture>. El recorte lo controla el contenedor .s-media con
  --s-fx/--s-fy (escritorio) y --s-fx-m/--s-fy-m (móvil).

  @param {image} image - Imagen de escritorio
  @param {image} [image_mobile] - Imagen de móvil (< 750px). Si falta, se usa la de escritorio
  @param {string} [sizes] - Atributo sizes de escritorio. Por defecto '100vw'
  @param {string} [sizes_mobile] - Atributo sizes de móvil. Por defecto '100vw'
  @param {string} [loading] - 'lazy' (defecto) o 'eager'
  @param {string} [fetchpriority] - 'auto' (defecto) o 'high'
  @param {string} [alt] - Texto alternativo si la imagen no tiene alt
  @param {string} [placeholder] - Nombre de placeholder_svg si no hay imagen. Por defecto 'lifestyle-1'

  @example
  {% render 'saucha-media', image: section.settings.image_desktop, image_mobile: section.settings.image_mobile, sizes: '50vw' %}
{% enddoc %}

{%- liquid
  assign desktop = image
  assign mobile = image_mobile
  if desktop == blank
    assign desktop = mobile
  endif

  assign media_sizes = sizes | default: '100vw'
  assign media_sizes_mobile = sizes_mobile | default: '100vw'
  assign media_loading = loading | default: 'lazy'
  assign media_priority = fetchpriority | default: 'auto'
  assign media_alt = desktop.alt | default: alt | escape
-%}

{%- if desktop != blank -%}
  <picture>
    {%- if mobile != blank and mobile != desktop -%}
      <source
        media="(max-width: 749px)"
        srcset="
          {%- for width in (1..5) -%}
            {%- assign w = width | times: 300 -%}
            {%- if w <= mobile.width -%}{{ mobile | image_url: width: w }} {{ w }}w,{%- endif -%}
          {%- endfor -%}
          {{ mobile | image_url: width: 1800 }} 1800w
        "
        sizes="{{ media_sizes_mobile }}"
        width="{{ mobile.width }}"
        height="{{ mobile.height }}"
      >
    {%- endif -%}
    {{
      desktop
      | image_url: width: 3200
      | image_tag:
        widths: '480, 750, 1000, 1400, 1800, 2400, 3200',
        sizes: media_sizes,
        loading: media_loading,
        fetchpriority: media_priority,
        class: 's-media__img',
        alt: media_alt
    }}
  </picture>
{%- else -%}
  {{ placeholder | default: 'lifestyle-1' | placeholder_svg_tag }}
{%- endif -%}
